load("@rules_python//python:defs.bzl", "py_library")

_VERILOG_ASSETS = [
    "verilog/a_axi_write_broadcastor_1_to_3.v",
    "verilog/a_axi_write_broadcastor_1_to_4.v",
    "verilog/arbiter.v",
    "verilog/async_mmap.v",
    "verilog/axi_crossbar.v",
    "verilog/axi_crossbar_addr.v",
    "verilog/axi_crossbar_rd.v",
    "verilog/axi_crossbar_wr.v",
    "verilog/axi_pipeline.v",
    "verilog/axi_register_rd.v",
    "verilog/axi_register_wr.v",
    "verilog/axis_adapter.v",
    "verilog/detect_burst.v",
    "verilog/fifo.v",
    "verilog/fifo_bram.v",
    "verilog/fifo_fwd.v",
    "verilog/fifo_srl.v",
    "verilog/generate_last.v",
    "verilog/priority_encoder.v",
    "verilog/relay_station.v",
]

py_library(
    name = "assets",
    srcs = [
        "__init__.py",
        "verilog/__init__.py",
    ],
    data = glob(["verilog/*.v"]),
    visibility = ["//tapa:__subpackages__"],
)

# Expose Verilog assets so `//tapa-core` cargo genrules can include
# them in their input set. Rust crates pull these in via `include_str!`
# at compile time, so the Bazel sandbox must materialize them alongside
# the cargo workspace.
exports_files(
    _VERILOG_ASSETS,
    visibility = ["//tapa-core:__pkg__"],
)
