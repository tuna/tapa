http_archive(
    name = "mdbook_macos_amd64",
    build_file_content = 'exports_files(["mdbook"])',
    sha256 = "4768a2a3cd6bff139feffd855dd8fb82ee356ecf822ae12ed9abcbde0633205b",
    url = "https://github.com/rust-lang/mdBook/releases/download/v0.4.52/mdbook-v0.4.52-x86_64-apple-darwin.tar.gz",
)

http_archive(
    name = "mdbook_macos_arm64",
    build_file_content = 'exports_files(["mdbook"])',
    sha256 = "4aee6a8ff54dc59fbe9bcf1c38b8f58583fba63535dff7a5ec8205f0cffc3fd4",
    url = "https://github.com/rust-lang/mdBook/releases/download/v0.4.52/mdbook-v0.4.52-aarch64-apple-darwin.tar.gz",
)

http_archive(
    name = "mdbook_admonish_linux_amd64",
    build_file_content = 'exports_files(["mdbook-admonish"])',
    sha256 = "64ce6dad3d20d3723c149e333d9cf85a9f7d057f18c2707d264698afdfc6679f",
    url = "https://github.com/tommilligan/mdbook-admonish/releases/download/v1.20.0/mdbook-admonish-v1.20.0-x86_64-unknown-linux-gnu.tar.gz",
)

http_archive(
    name = "mdbook_admonish_macos_amd64",
    build_file_content = 'exports_files(["mdbook-admonish"])',
    sha256 = "f78237e9335554377fb4a83a7cb4ac382743729e1f3ca67d2e0e23314bcacab9",
    url = "https://github.com/tommilligan/mdbook-admonish/releases/download/v1.20.0/mdbook-admonish-v1.20.0-x86_64-apple-darwin.tar.gz",
)

http_archive(
    name = "mdbook_admonish_macos_arm64",
    build_file_content = 'exports_files(["mdbook-admonish"])',
    # No aarch64-apple-darwin build exists; use x86_64 via Rosetta 2.
    sha256 = "f78237e9335554377fb4a83a7cb4ac382743729e1f3ca67d2e0e23314bcacab9",
    url = "https://github.com/tommilligan/mdbook-admonish/releases/download/v1.20.0/mdbook-admonish-v1.20.0-x86_64-apple-darwin.tar.gz",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2021",
    versions = ["1.88.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

llvm.toolchain(
    llvm_versions = {
        # Latest version supporting Ubuntus
        "ubuntu-18.04-x86_64": "18.1.8",
        "ubuntu-20.04-x86_64": "18.1.8",
        "ubuntu-22.04-x86_64": "18.1.8",
        "ubuntu-24.04-x86_64": "18.1.8",
        "ubuntu-25.04-x86_64": "18.1.8",
        # Latest version supporting RHELs
        "rhel-8.6-x86_64": "14.0.0",
        "rhel-8.7-x86_64": "14.0.0",
        "rhel-8.8-x86_64": "14.0.0",
        "rhel-8.9-x86_64": "14.0.0",
        "rhel-8.10-x86_64": "14.0.0",
        "rhel-9.0-x86_64": "14.0.0",
        "rhel-9.1-x86_64": "14.0.0",
        "rhel-9.2-x86_64": "14.0.0",
        "rhel-9.3-x86_64": "14.0.0",
        "rhel-9.4-x86_64": "14.0.0",
        "rhel-9.5-x86_64": "14.0.0",
        # Other platforms use latest
        "": "20.1.8",
    },
    stdlib = {
        "linux-x86_64": "stdc++",
        "linux-aarch64": "stdc++",
    },
)
use_repo(llvm, "llvm_toolchain")
use_repo(llvm, "llvm_toolchain_llvm")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)

register_toolchains(
    "@rules_verilator//verilator:verilator_toolchain",
    dev_dependency = True,
)

bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")  # Required by tapacc
bazel_dep(name = "rules_boost", repo_name = "com_github_nelhage_rules_boost")
git_override(
    module_name = "rules_boost",
    commit = "795af624bbc1a285b73358ee53eb056e30723d26",
    patch_cmds = [
        # Enable BOOST_USE_SEGMENTED_STACKS, BOOST_USE_ASAN, BOOST_USE_UCONTEXT.
        # Use perl -i for cross-platform compatibility (sed -i differs between GNU and BSD).
        """perl -i -pe 'print qq{    defines=["BOOST_USE_ASAN","BOOST_USE_SEGMENTED_STACKS","BOOST_USE_UCONTEXT"],\\n} if /name = "context",/' boost.BUILD""",
        "perl -i -ne 'print unless /fiber\\.cpp/' boost.BUILD",
    ],
    remote = "https://github.com/nelhage/rules_boost.git",
)

non_module_boost_repositories = use_extension("@com_github_nelhage_rules_boost//:boost/repositories.bzl", "non_module_dependencies")
use_repo(non_module_boost_repositories, "boost")

bazel_dep(name = "gflags", version = "2.2.2.bcr.1")
bazel_dep(name = "glog", version = "0.5.0")  # Must be 0.5.0; dpi requires this version.
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

single_version_override(
    module_name = "glog",
    patches = ["//bazel:patches/glog/0001-Fix-unused-but-set-variable.patch"],
)

resolve_vars = use_extension("//bazel:vars.bzl", "resolve_vars", dev_dependency = True)
use_repo(resolve_vars, "vars")

load_dependencies = use_extension(
    "//bazel:dependencies.bzl",
    "load_dependencies",
    dev_dependency = True,
)
use_repo(load_dependencies, "ssh_key", "vitis_hls", "xsim_legacy_rdi", "xsim_xv")

bazel_dep(name = "libuuid", version = "2.41.2")

LLVM_VERSION_MAJOR = 20

LLVM_VERSION_MINOR = 1

LLVM_VERSION_PATCH = 8

LLVM_VERSION = "{}.{}.{}".format(LLVM_VERSION_MAJOR, LLVM_VERSION_MINOR, LLVM_VERSION_PATCH)

LLVM_SHA256 = "6898f963c8e938981e6c4a302e83ec5beb4630147c7311183cf61069af16333d"

http_archive(
    name = "tapa-llvm-project",
    patch_args = ["-p1"],
    patch_cmds = [
        """
        cp -r utils/bazel/llvm-project-overlay/* .
        rm -rf utils/bazel
        """,
        """
        cat >MODULE.bazel <<EOF
module(
    name = "llvm-project",
    version = "{}",
)

# Skylark dependencies
bazel_dep(name = "bazel_skylib", version = "1.8.1")

# Library dependencies
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.1.2")
EOF
        """.format(LLVM_VERSION),
        """echo >BUILD.bazel""",
        """echo 'llvm_targets = ["X86", "AArch64"]' >llvm/targets.bzl""",
        """
        cat >vars.bzl <<EOF
LLVM_VERSION = "{0}.{1}.{2}"
LLVM_VERSION_MAJOR = {0}
LLVM_VERSION_MINOR = {1}
LLVM_VERSION_PATCH = {2}
PACKAGE_VERSION = "{0}.{1}.{2}"
MAX_CLANG_ABI_COMPAT_VERSION = "{0}"
EOF
        """.format(LLVM_VERSION_MAJOR, LLVM_VERSION_MINOR, LLVM_VERSION_PATCH),
    ],
    patches = [
        "//bazel:patches/tapa-llvm-project/0001-Disable-zlib-zstd-mpfr-pfm-and-proto.patch",
        "//bazel:patches/tapa-llvm-project/0002-Add-TAPA-pragmas-to-Clang.patch",
        "//bazel:patches/tapa-llvm-project/0003-Wno-error.patch",
        "//bazel:patches/tapa-llvm-project/0004-Patch-missing-macro.patch",
    ],
    sha256 = LLVM_SHA256,
    strip_prefix = "llvm-project-{}.src".format(LLVM_VERSION),
    urls = ["https://github.com/llvm/llvm-project/releases/download/llvmorg-{0}/llvm-project-{0}.src.tar.xz".format(LLVM_VERSION)],
)

