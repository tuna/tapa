"""TAPA: dataflow HLS framework for fast compilation and high-frequency FPGA accelerators."""

module(name = "tapa")

bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)
bazel_dep(name = "rules_cc", version = "0.2.26", dev_dependency = True)
bazel_dep(name = "rules_rust", version = "0.74.0", dev_dependency = True)
bazel_dep(name = "rules_pkg", version = "1.3.0", dev_dependency = True)

# 2.0.0-rc3 generated launchers require sys._base_executable, which is absent
# from the Python used by the Ubuntu 18.04 CI image. Load-bearing: the
# tapa-llvm-project repo references @rules_python//python:defs.bzl.
bazel_dep(name = "rules_python", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "rules_verilator", version = "1.1.2", dev_dependency = True)
bazel_dep(name = "rules_verilog", version = "1.4.3", dev_dependency = True)
bazel_dep(name = "toolchains_llvm", version = "1.11.3", dev_dependency = True)
bazel_dep(name = "verilator", version = "5.044", dev_dependency = True)

# 5.046.bcr.3 pulls rules_cc_autoconf through BCR bison/flex/m4. That helper
# requires C++17 <filesystem>, which is unavailable in the Ubuntu 18.04 CI image.
single_version_override(
    module_name = "verilator",
    version = "5.044",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# mdBook 0.5 changed the preprocessor RenderContext format; the latest
# mdbook-admonish (1.20.0, including its main branch) still links mdbook
# 0.4 and cannot parse 0.5 input. Keep mdBook on 0.4.x until
# mdbook-admonish supports 0.5.
http_archive(
    name = "mdbook_linux_amd64",
    build_file_content = 'exports_files(["mdbook"])',
    sha256 = "c0b903f01dd8f4edc644372ad2b80b1fdddd12552d37b6a098657cbd8eddd768",
    url = "https://github.com/rust-lang/mdBook/releases/download/v0.4.52/mdbook-v0.4.52-x86_64-unknown-linux-gnu.tar.gz",
)

http_archive(
    name = "mdbook_macos_amd64",
    build_file_content = 'exports_files(["mdbook"])',
    sha256 = "4768a2a3cd6bff139feffd855dd8fb82ee356ecf822ae12ed9abcbde0633205b",
    url = "https://github.com/rust-lang/mdBook/releases/download/v0.4.52/mdbook-v0.4.52-x86_64-apple-darwin.tar.gz",
)

http_archive(
    name = "mdbook_macos_arm64",
    build_file_content = 'exports_files(["mdbook"])',
    sha256 = "4aee6a8ff54dc59fbe9bcf1c38b8f58583fba63535dff7a5ec8205f0cffc3fd4",
    url = "https://github.com/rust-lang/mdBook/releases/download/v0.4.52/mdbook-v0.4.52-aarch64-apple-darwin.tar.gz",
)

http_archive(
    name = "mdbook_admonish_linux_amd64",
    build_file_content = 'exports_files(["mdbook-admonish"])',
    sha256 = "64ce6dad3d20d3723c149e333d9cf85a9f7d057f18c2707d264698afdfc6679f",
    url = "https://github.com/tommilligan/mdbook-admonish/releases/download/v1.20.0/mdbook-admonish-v1.20.0-x86_64-unknown-linux-gnu.tar.gz",
)

http_archive(
    name = "mdbook_admonish_macos_amd64",
    build_file_content = 'exports_files(["mdbook-admonish"])',
    sha256 = "f78237e9335554377fb4a83a7cb4ac382743729e1f3ca67d2e0e23314bcacab9",
    url = "https://github.com/tommilligan/mdbook-admonish/releases/download/v1.20.0/mdbook-admonish-v1.20.0-x86_64-apple-darwin.tar.gz",
)

http_archive(
    name = "mdbook_admonish_macos_arm64",
    build_file_content = 'exports_files(["mdbook-admonish"])',
    # No aarch64-apple-darwin build exists; use x86_64 via Rosetta 2.
    sha256 = "f78237e9335554377fb4a83a7cb4ac382743729e1f3ca67d2e0e23314bcacab9",
    url = "https://github.com/tommilligan/mdbook-admonish/releases/download/v1.20.0/mdbook-admonish-v1.20.0-x86_64-apple-darwin.tar.gz",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)

# Static tools avoid optional host-library dependencies such as libxml2.
# The matching official distribution supplies headers and compiler-rt.
http_archive(
    name = "llvm_static_tools",
    build_file_content = 'exports_files(["BUILD.bazel"])',
    sha256 = "2808ea0503af3656373fc141ddc7d082b53c7f858efd5245aed0241734257348",
    urls = ["https://github.com/hermeticbuild/hermetic-llvm/releases/download/llvm-23.1.2-2/llvm-toolchain-minimal-23.1.2-linux-amd64-musl.tar.zst"],
)

llvm_distribution = use_repo_rule("@toolchains_llvm//toolchain:rules.bzl", "llvm")

llvm_distribution(
    name = "llvm_distribution",
    llvm_versions = {"": "23.1.2"},
)

llvm_toolchain = use_repo_rule("//bazel:llvm_toolchain.bzl", "llvm_toolchain")

llvm_toolchain(
    name = "llvm_toolchain_distribution",
    distribution = "@llvm_distribution//:BUILD.bazel",
    tools = "@llvm_static_tools//:BUILD.bazel",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2021",
    extra_target_triples = ["aarch64-unknown-linux-gnu"],
    versions = ["1.99.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

vck190_sysroot = use_repo_rule("//bazel:vck190_sysroot.bzl", "vck190_sysroot")

vck190_sysroot(name = "vck190_sysroot")

llvm.toolchain(
    cxx_include_layout = {"linux-aarch64": "yocto"},
    llvm_version = "23.1.2",
    multiarch = {"linux-aarch64": "aarch64-amd-linux"},
    stdlib = {
        "linux-x86_64": "stdc++",
        "linux-aarch64": "stdc++-13.4.0",
    },
)
llvm.sysroot(
    label = "@vck190_sysroot//sysroot:sysroot",
    targets = ["linux-aarch64"],
)
llvm.toolchain_root(label = "@llvm_toolchain_distribution//:BUILD.bazel")
use_repo(llvm, "llvm_toolchain")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)

register_toolchains(
    "@rules_verilator//verilator:verilator_toolchain",
    dev_dependency = True,
)

bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")  # Required by tapacc
bazel_dep(name = "rules_boost", repo_name = "com_github_nelhage_rules_boost")
git_override(
    module_name = "rules_boost",
    commit = "d4d306ef48b7dbddf0389e48b90f6eb74ec18a71",
    patch_cmds = [
        # Enable segmented stacks where the GCC runtime supports them, plus
        # BOOST_USE_ASAN and BOOST_USE_UCONTEXT on every target.
        # Use perl -i for cross-platform compatibility (sed -i differs between GNU and BSD).
        """perl -i -pe 'print qq{config_setting(\\n    name = "aarch64",\\n    constraint_values = ["@" + "platforms//cpu:aarch64"],\\n)\\n\\n} if $. == 1' boost.BUILD""",
        """perl -i -pe 'print qq{    defines=select({":aarch64":["BOOST_USE_ASAN","BOOST_USE_UCONTEXT"],"//conditions:default":["BOOST_USE_ASAN","BOOST_USE_SEGMENTED_STACKS","BOOST_USE_UCONTEXT"]}),\\n} if /name = "context",/' boost.BUILD""",
        "perl -i -ne 'print unless /fiber\\.cpp/' boost.BUILD",
    ],
    remote = "https://github.com/nelhage/rules_boost.git",
)

non_module_boost_repositories = use_extension("@com_github_nelhage_rules_boost//:boost/repositories.bzl", "non_module_dependencies")
use_repo(non_module_boost_repositories, "boost")

bazel_dep(name = "gflags", version = "2.3.1")

# gflags 2.3.1 replaced include_prefix = "gflags" with includes = ["gen"].
# Both expose <gflags/gflags.h> to cc dependents, but only the include_prefix
# layout routes headers through _virtual_includes artifacts in CcInfo
# compilation contexts, which bazel/header_extractor.bzl requires to stage
# runtime headers for tapacc and the Vitis HLS jobs.
single_version_override(
    module_name = "gflags",
    patches = ["//bazel:patches/gflags/0001-Restore-include-prefix-layout.patch"],
)

bazel_dep(name = "glog", version = "0.5.0")  # Must be 0.5.0; dpi requires this version.
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")

single_version_override(
    module_name = "glog",
    patches = ["//bazel:patches/glog/0001-Fix-unused-but-set-variable.patch"],
)

resolve_vars = use_extension("//bazel:vars.bzl", "resolve_vars", dev_dependency = True)
use_repo(resolve_vars, "vars")

load_dependencies = use_extension(
    "//bazel:dependencies.bzl",
    "load_dependencies",
    dev_dependency = True,
)
use_repo(load_dependencies, "ssh_key", "vitis_hls", "xsim_xv")

bazel_dep(name = "libuuid", version = "2.41.2.bcr.0")

LLVM_VERSION_MAJOR = 23

LLVM_VERSION_MINOR = 1

LLVM_VERSION_PATCH = 2

LLVM_VERSION = "{}.{}.{}".format(LLVM_VERSION_MAJOR, LLVM_VERSION_MINOR, LLVM_VERSION_PATCH)

LLVM_SHA256 = "c98bbef08a2b4c2613cd50e9aa9ae7b69b1fe6c16b2c40373bc0ab6116fdf78a"

http_archive(
    name = "tapa-llvm-project",
    patch_args = ["-p1"],
    patch_cmds = [
        """
        cp -r utils/bazel/llvm-project-overlay/* .
        rm -rf utils/bazel
        """,
        """
        cat >MODULE.bazel <<EOF
module(
    name = "llvm-project",
    version = "{}",
)

# Skylark dependencies
bazel_dep(name = "bazel_skylib", version = "1.8.1")

# Library dependencies
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.1.2")
EOF
        """.format(LLVM_VERSION),
        """echo >BUILD.bazel""",
        """echo 'llvm_targets = ["X86", "AArch64"]' >llvm/targets.bzl""",
        """
        cat >vars.bzl <<EOF
LLVM_VERSION = "{0}.{1}.{2}"
LLVM_VERSION_MAJOR = {0}
LLVM_VERSION_MINOR = {1}
LLVM_VERSION_PATCH = {2}
PACKAGE_VERSION = "{0}.{1}.{2}"
EOF
        """.format(LLVM_VERSION_MAJOR, LLVM_VERSION_MINOR, LLVM_VERSION_PATCH),
    ],
    patches = [
        "//bazel:patches/tapa-llvm-project/0001-Disable-zlib-zstd-mpfr-and-pfm.patch",
        "//bazel:patches/tapa-llvm-project/0002-Add-TAPA-pragmas-to-Clang.patch",
        "//bazel:patches/tapa-llvm-project/0003-Wno-error.patch",
        "//bazel:patches/tapa-llvm-project/0004-Unconditional-backtrace-and-mallinfo-defines.patch",
    ],
    sha256 = LLVM_SHA256,
    strip_prefix = "llvm-project-{}.src".format(LLVM_VERSION),
    urls = ["https://github.com/llvm/llvm-project/releases/download/llvmorg-{0}/llvm-project-{0}.src.tar.xz".format(LLVM_VERSION)],
)

# Test data
http_file(
    name = "facebook_combined",
    downloaded_file_path = "facebook.txt.gz",
    sha256 = "125e84db872eeba443d270c70315c256b0af43a502fcfe51f50621166ad035d7",
    url = "https://snap.stanford.edu/data/facebook_combined.txt.gz",
)

