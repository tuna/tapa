+// Shared argument parsing for the TAPA attribute handlers, used from both
+// SemaDeclAttr.cpp and SemaStmtAttr.cpp.
+
+#ifndef LLVM_CLANG_SEMA_TAPAATTRS_H
+#define LLVM_CLANG_SEMA_TAPAATTRS_H
+
+#include "clang/Sema/Sema.h"
+
+namespace clang {
+
+// Parse a dependence attribute's arguments in the vendor's order:
+// (variable, class, type, direction, dependent, distance). The enum
+// spellings are validated; distance takes a string (macro passthrough) or
+// an integer constant expression.
+inline bool parseTapaDependenceArgs(Sema &S, const ParsedAttr &A,
+                                    StringRef &variable, StringRef &class_,
+                                    StringRef &type, StringRef &direction,
+                                    uint32_t &dependent) {
+  if (!S.checkStringLiteralArgumentAttr(A, 0, variable)) return false;
+  auto parseEnum = [&](unsigned idx, StringRef &out,
+                       std::initializer_list<StringRef> allowed) {
+    if (A.getNumArgs() <= idx) return true;
+    SourceLocation loc;
+    if (!S.checkStringLiteralArgumentAttr(A, idx, out, &loc)) return false;
+    if (out.empty()) return true;
+    for (StringRef a : allowed)
+      if (out == a) return true;
+    S.Diag(loc, diag::warn_attribute_type_not_supported) << A << out;
+    return false;
+  };
+  if (!parseEnum(1, class_, {"array", "pointer"})) return false;
+  if (!parseEnum(2, type, {"inter", "intra"})) return false;
+  if (!parseEnum(3, direction, {"RAW", "WAR", "WAW"})) return false;
+  if (A.getNumArgs() > 4 &&
+      !S.checkUInt32Argument(A, A.getArgAsExpr(4), dependent))
+    return false;
+  // Distance (arg 5) is any expression syntactically: a string (macro
+  // passthrough), an integer constant, or an identifier naming one. The
+  // lowering spells it from the source, so only its shape is validated.
+  if (A.getNumArgs() > 5) {
+    const Expr *e = A.getArgAsExpr(5)->IgnoreImpCasts();
+    if (!isa<StringLiteral>(e) && !isa<IntegerLiteral>(e) &&
+        !isa<DeclRefExpr>(e) && !e->isEvaluatable(S.Context)) {
+      S.Diag(A.getLoc(), diag::err_attribute_argument_type)
+          << A << AANT_ArgumentString;
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace clang
+
+#endif  // LLVM_CLANG_SEMA_TAPAATTRS_H
