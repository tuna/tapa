+#include "TapaAttrs.h"
+
+// Begin TAPA
+
+static void handleTapaPipelineAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  // Pipeline belongs on a loop or a function; on a variable it only ever
+  // surfaces as the leak guard's hard error, far from the cause. Warn at
+  // parse time, the way unroll does.
+  if (!isa<FunctionDecl>(D)) {
+    S.Diag(D->getBeginLoc(), diag::warn_attribute_type_not_supported)
+        << AL << "unsupported pipeline target";
+    return;
+  }
+  uint32_t ii = 0xFFFFFFFF;  // omitted; an explicit 0 means `pipeline off`
+  StringRef style;
+  if (AL.getNumArgs() > 0) {
+    if (const auto *StrE = dyn_cast<StringLiteral>(AL.getArgAsExpr(0)
+                                                           ->IgnoreImpCasts())) {
+      style = StrE->getString();
+    } else if (!S.checkUInt32Argument(AL, AL.getArgAsExpr(0), ii)) {
+      return;
+    }
+  }
+  if (AL.getNumArgs() > 1 &&
+      !S.checkStringLiteralArgumentAttr(AL, 1, style)) {
+    return;
+  }
+
+  D->addAttr(::new (S.Context) TapaPipelineAttr(S.Context, AL, ii, style));
+}
+
+static void handleTapaUnrollAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  S.Diag(D->getBeginLoc(), diag::warn_attribute_type_not_supported)
+      << AL << "unsupported unroll target";
+}
+
+static void handleTapaTargetAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  StringRef TargetStr;
+  SourceLocation ArgLoc;
+
+  if (AL.getNumArgs() == 0)
+    TargetStr = "xilinx_hls";
+  else if (!S.checkStringLiteralArgumentAttr(AL, 0, TargetStr, &ArgLoc))
+    return;
+
+  TapaTargetAttr::TargetType Target;
+  if (!TapaTargetAttr::ConvertStrToTargetType(TargetStr, Target)) {
+    S.Diag(AL.getLoc(), diag::warn_attribute_type_not_supported)
+        << AL << TargetStr << ArgLoc;
+    return;
+  }
+
+  D->addAttr(::new (S.Context) TapaTargetAttr(S.Context, AL, Target));
+}
+
+// Parses an optional integer whose zero is meaningful (offset, latency):
+// -1 means "omitted" and the vendor default applies; anything below -1 is
+// rejected. Stored in the attribute's uint32 as-is.
+static bool parseOptionalInt(Sema &S, const ParsedAttr &AL, unsigned idx,
+                             uint32_t &out) {
+  Expr::EvalResult result;
+  if (!AL.getArgAsExpr(idx)->EvaluateAsInt(result, S.Context)) {
+    S.Diag(AL.getLoc(), diag::err_attribute_argument_type)
+        << AL << AANT_ArgumentIntegerConstant;
+    return false;
+  }
+  const int64_t value = result.Val.getInt().getSExtValue();
+  if (value < -1 || value > 0x7fffffff) {
+    S.Diag(AL.getLoc(), diag::err_attribute_argument_out_of_range)
+        << AL << -1 << 0x7fffffff;
+    return false;
+  }
+  out = static_cast<uint32_t>(value);
+  return true;
+}
+
+static void handleTapaPartitionAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  TapaPartitionAttr::PartType type = TapaPartitionAttr::Complete;
+  // factor/dim use the -1 "omitted" sentinel (dim = 0 means all dims).
+  uint32_t factor = 0xFFFFFFFF, dim = 0xFFFFFFFF;
+  SourceLocation type_loc;
+  if (AL.getNumArgs() > 0) {
+    StringRef str;
+    if (!S.checkStringLiteralArgumentAttr(AL, 0, str, &type_loc)) return;
+    if (!TapaPartitionAttr::ConvertStrToPartType(str, type)) {
+      S.Diag(type_loc, diag::warn_attribute_type_not_supported) << AL << str;
+      return;
+    }
+  }
+  if (AL.getNumArgs() > 1 && !parseOptionalInt(S, AL, 1, factor)) return;
+  if (AL.getNumArgs() > 2 && !parseOptionalInt(S, AL, 2, dim)) return;
+  // A factor is meaningless for complete partitioning, and the vendor
+  // accepts the result silently — a factor/dim slip only ever surfaces as a
+  // wrong-pragma audit. Reject it at parse time.
+  if (type == TapaPartitionAttr::Complete && factor != 0xFFFFFFFF) {
+    S.Diag(type_loc, diag::err_attribute_argument_type)
+        << AL << "complete partitioning takes no factor";
+    return;
+  }
+  D->addAttr(::new (S.Context) TapaPartitionAttr(S.Context, AL, type, factor, dim));
+}
+
+static void handleTapaStorageAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  StringRef type, impl;
+  uint32_t latency = 0xFFFFFFFF;  // sentinel: omitted
+  if (AL.getNumArgs() > 0 && !S.checkStringLiteralArgumentAttr(AL, 0, type)) return;
+  if (AL.getNumArgs() > 1 && !S.checkStringLiteralArgumentAttr(AL, 1, impl)) return;
+  if (AL.getNumArgs() > 2 && !parseOptionalInt(S, AL, 2, latency)) return;
+  D->addAttr(::new (S.Context) TapaStorageAttr(S.Context, AL, type, impl, latency));
+}
+
+static void handleTapaAggregateAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  D->addAttr(::new (S.Context) TapaAggregateAttr(S.Context, AL));
+}
+
+static void handleTapaBindOpAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  StringRef op, impl;
+  uint32_t latency = 0xFFFFFFFF;  // sentinel: omitted
+  if (!S.checkStringLiteralArgumentAttr(AL, 0, op)) return;
+  if (!S.checkStringLiteralArgumentAttr(AL, 1, impl)) return;
+  if (AL.getNumArgs() > 2 && !parseOptionalInt(S, AL, 2, latency)) return;
+  D->addAttr(::new (S.Context) TapaBindOpAttr(S.Context, AL, op, impl, latency));
+}
+
+static void handleTapaArrayMapAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  StringRef instance;
+  if (!S.checkStringLiteralArgumentAttr(AL, 0, instance)) return;
+  uint32_t offset = 0xFFFFFFFF;  // sentinel: omitted (see parseOptionalInt)
+  if (AL.getNumArgs() > 1 && !parseOptionalInt(S, AL, 1, offset)) return;
+  StringRef orient;
+  SourceLocation loc;
+  if (AL.getNumArgs() > 2) {
+    if (!S.checkStringLiteralArgumentAttr(AL, 2, orient, &loc)) return;
+    if (!orient.empty() && orient != "horizontal" && orient != "vertical") {
+      S.Diag(loc, diag::warn_attribute_type_not_supported) << AL << orient;
+      return;
+    }
+  }
+  D->addAttr(::new (S.Context) TapaArrayMapAttr(S.Context, AL, instance, offset, orient));
+}
+
+// Region attrs (latency, dependence, tripcount, flatten, balance) may sit
+// before a declaration statement; they then attach to the VarDecl and are
+// lowered with the same pragma text.
+static void handleTapaRegionDeclAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  switch (AL.getKind()) {
+  default: return;
+  case ParsedAttr::AT_TapaFlatten: {
+    uint32_t enable = 1;
+    if (AL.getNumArgs() > 0 && !S.checkUInt32Argument(AL, AL.getArgAsExpr(0), enable))
+      return;
+    D->addAttr(::new (S.Context) TapaFlattenAttr(S.Context, AL, enable));
+    return;
+  }
+  case ParsedAttr::AT_TapaBalance:
+    D->addAttr(::new (S.Context) TapaBalanceAttr(S.Context, AL));
+    return;
+  case ParsedAttr::AT_TapaTripcount:
+  case ParsedAttr::AT_TapaLatency: {
+    uint32_t first = 0, second = 0;
+    if (!S.checkUInt32Argument(AL, AL.getArgAsExpr(0), first)) return;
+    if (!S.checkUInt32Argument(AL, AL.getArgAsExpr(1), second)) return;
+    if (AL.getKind() == ParsedAttr::AT_TapaTripcount)
+      D->addAttr(::new (S.Context) TapaTripcountAttr(S.Context, AL, first, second));
+    else
+      D->addAttr(::new (S.Context) TapaLatencyAttr(S.Context, AL, first, second));
+    return;
+  }
+  case ParsedAttr::AT_TapaDependence: {
+    StringRef variable, class_, type, direction;
+    uint32_t dependent = 0;
+    if (!parseTapaDependenceArgs(S, AL, variable, class_, type, direction,
+                                 dependent))
+      return;
+    Expr *distance =
+        AL.getNumArgs() > 5 ? AL.getArgAsExpr(5) : nullptr;
+    D->addAttr(::new (S.Context) TapaDependenceAttr(S.Context, AL, variable,
+                                                    class_, type, direction,
+                                                    dependent, distance));
+    return;
+  }
+  }
+}
