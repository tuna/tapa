load("@vars//:vars.bzl", "XILINX_TOOL_VERSION")
load("//bazel:v++_rules.bzl", "xilinx_wrapper")
load("//bazel:xilinx_versions.bzl", "vitis_layout_subdir")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_macos",
    constraint_values = ["@platforms//os:macos"],
)

exports_files([
    "sim_env.sh",
])

xilinx_wrapper(
    name = "v++",
    argv0 = "v++",
    target_compatible_with = ["@platforms//os:linux"],
    tool = "Vitis",
)

xilinx_wrapper(
    name = "v++_env.sh",
    target_compatible_with = ["@platforms//os:linux"],
    tool = "Vitis",
)

xilinx_wrapper(
    name = "xrt_env.sh",
    target_compatible_with = ["@platforms//os:linux"],
    tool = "Vitis",
    xrt = True,
)

# HLS moved from the standalone `Vitis_HLS/<ver>` install tree into
# `Vitis/<ver>` at 2024.2; pick the layout the configured version ships.
# With the literal legacy name, this wrapper silently `exec`s through on
# newer installs (its tool dir never exists), leaving `vitis_hls`
# unresolvable inside strict-action-env sandboxes.
xilinx_wrapper(
    name = "vitis_hls_env",
    tool = vitis_layout_subdir(XILINX_TOOL_VERSION).strip("/"),
)

xilinx_wrapper(
    name = "xsc_xv",
    argv0 = "xsc",
    target_compatible_with = ["@platforms//os:linux"],
    tool = "Vivado",
)
