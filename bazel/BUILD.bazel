load("//bazel:v++_rules.bzl", "xilinx_wrapper")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "is_macos",
    constraint_values = ["@platforms//os:macos"],
)

exports_files([
    "sim_env.sh",
])

xilinx_wrapper(
    name = "v++",
    argv0 = "v++",
    target_compatible_with = ["@platforms//os:linux"],
    tool = "Vitis",
)

xilinx_wrapper(
    name = "v++_env.sh",
    target_compatible_with = ["@platforms//os:linux"],
    tool = "Vitis",
)

xilinx_wrapper(
    name = "xrt_env.sh",
    target_compatible_with = ["@platforms//os:linux"],
    tool = "Vitis",
    xrt = True,
)

xilinx_wrapper(
    name = "vitis_hls_env",
    tool = "Vitis_HLS",
)

xilinx_wrapper(
    name = "xsc_xv",
    argv0 = "xsc",
    target_compatible_with = ["@platforms//os:linux"],
    tool = "Vivado",
)
