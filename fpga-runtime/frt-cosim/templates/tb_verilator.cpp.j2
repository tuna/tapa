// The device memory one mmap argument sees: the host's shared segment for
// it, mapped in, so host and kernel see each other's writes as the run goes
// (a ring's frames move during it). Each argument is addressed through its
// own AXI port over a known range.
//
// Addresses outside the range are ordinary traffic, not errors -- the last
// full-width beat of a buffer can run past the end. Reads there yield zero and
// writes there are dropped.
class MemRegion {
 public:
  explicit MemRegion(uint64_t base) : base_(base) {}

  void attach(const char* port) {
    uint64_t size = 0;
    data_ = tapa_axi_memory(port, &size);
    size_ = data_ == nullptr ? 0 : static_cast<size_t>(size);
  }

  void read(uint64_t addr, void* buf, size_t nbytes) const {
    auto* dst = reinterpret_cast<uint8_t*>(buf);
    for (size_t i = 0; i < nbytes; i++) {
      // Below `base_` this wraps to a huge value, which the bound rejects.
      const uint64_t off = addr + i - base_;
      dst[i] = off < size_ ? data_[off] : 0;
    }
  }

  void write(uint64_t addr, const void* buf, const void* strb_ptr, size_t nbytes,
             size_t lane) {
    auto* src = reinterpret_cast<const uint8_t*>(buf);
    auto* strb = reinterpret_cast<const uint8_t*>(strb_ptr);
    for (size_t i = 0; i < nbytes; i++) {
      const size_t byte = lane + i;
      const uint64_t off = addr + i - base_;
      if (off < size_ && (strb[byte / 8] & (1 << (byte % 8))))
        data_[off] = src[byte];
    }
  }

 private:
  uint64_t base_;
  uint8_t* data_ = nullptr;
  size_t size_ = 0;
};

static V{{ top_name }}* dut;

static constexpr int kMaxOutstanding = 16;

static size_t axi_lane(const char* port, uint64_t addr, size_t beat_bytes,
                       size_t bus_bytes) {
  const size_t lane = addr % bus_bytes;
  if (beat_bytes > bus_bytes - lane) {
    std::cerr << "Unsupported AXI transfer on " << port << ": " << beat_bytes
              << " bytes at address " << addr << " exceeds the " << bus_bytes
              << "-byte data bus\n";
    std::exit(EXIT_FAILURE);
  }
  return lane;
}

template <typename Id>
struct AxiReadReq {
  uint64_t addr;
  uint8_t len;
  Id id;
  uint8_t beat;
  uint8_t size;
};

template <typename Id>
struct AxiWriteReq {
  uint64_t addr;
  Id id;
  uint8_t beat;
  uint8_t size;
};

{% for arg in mmap_args %}
static MemRegion mem_{{ arg.ident }}(0x{{ "{:016x}"|format(arg.base_addr) }}ULL);
static std::deque<AxiReadReq<std::remove_reference_t<decltype(dut->{{ arg.axi.arid }})>>> rd_q_{{ arg.ident }};
static bool rd_have_data_{{ arg.ident }} = false;
static std::deque<AxiWriteReq<std::remove_reference_t<decltype(dut->{{ arg.axi.awid }})>>> wr_q_{{ arg.ident }};
static std::deque<std::remove_reference_t<decltype(dut->{{ arg.axi.awid }})>> b_q_{{ arg.ident }};
{% endfor %}

{% for arg in stream_args %}
static bool stream_in_have_{{ arg.ident }} = false;
{% if mode == "hls" %}
static bool stream_in_consumed_{{ arg.ident }} = false;
{% endif %}
static std::array<uint8_t, {{ arg.dpi_width_bytes }}> stream_in_data_{{ arg.ident }} = {};
{% endfor %}

static void tick() {
  // Settle every driven input before sampling the edge handshakes.
  dut->ap_clk = 0;
  dut->eval();
  if (dut->ap_rst_n) {
{% if mode == "hls" %}
    // Capture the handshake at this edge. The state after the edge may
    // request another read before its payload has actually been consumed.
{% for arg in stream_args %}
    stream_in_consumed_{{ arg.ident }} = stream_in_have_{{ arg.ident }} && dut->{{ arg.sig.read }};
{% endfor %}
{% endif %}
{% for arg in mmap_args %}
    if (dut->{{ arg.axi.arvalid }} && dut->{{ arg.axi.arready }}) {
      rd_q_{{ arg.ident }}.push_back({dut->{{ arg.axi.araddr }}, (uint8_t)dut->{{ arg.axi.arlen }},
                                      dut->{{ arg.axi.arid }}, 0, (uint8_t)dut->{{ arg.axi.arsize }}});
    }
    if (dut->{{ arg.axi.rvalid }} && dut->{{ arg.axi.rready }}) {
      auto& r = rd_q_{{ arg.ident }}.front();
      if (r.beat >= r.len) rd_q_{{ arg.ident }}.pop_front();
      else r.beat++;
      rd_have_data_{{ arg.ident }} = false;
    }
    if (dut->{{ arg.axi.awvalid }} && dut->{{ arg.axi.awready }}) {
      wr_q_{{ arg.ident }}.push_back({dut->{{ arg.axi.awaddr }}, dut->{{ arg.axi.awid }}, 0,
                                      (uint8_t)dut->{{ arg.axi.awsize }}});
    }
    if (dut->{{ arg.axi.wvalid }} && dut->{{ arg.axi.wready }} && !wr_q_{{ arg.ident }}.empty()) {
      auto& w = wr_q_{{ arg.ident }}.front();
      const size_t beat_bytes = size_t{1} << w.size;
      const uint64_t addr = w.addr + (uint64_t)w.beat * beat_bytes;
      const size_t lane = axi_lane("{{ arg.name }}", addr, beat_bytes,
                                   {{ arg.data_width_bytes }});
      mem_{{ arg.ident }}.write(addr, &dut->{{ arg.axi.wdata }},
                                &dut->{{ arg.axi.wstrb }}, beat_bytes, lane);
      w.beat++;
      if (dut->{{ arg.axi.wlast }}) {
        b_q_{{ arg.ident }}.push_back(w.id);
        wr_q_{{ arg.ident }}.pop_front();
      }
    }
    if (dut->{{ arg.axi.bvalid }} && dut->{{ arg.axi.bready }}) {
      b_q_{{ arg.ident }}.pop_front();
    }
{% endfor %}
{% if mode == "vitis" %}
{% for arg in stream_args %}
    if (stream_in_have_{{ arg.ident }} && dut->{{ arg.sig.tvalid }} && dut->{{ arg.sig.tready }}) {
      stream_in_have_{{ arg.ident }} = false;
    }
{% endfor %}
{% for arg in stream_out_args %}
    if (dut->{{ arg.sig.tvalid }} && dut->{{ arg.sig.tready }}) {
      std::array<uint8_t, {{ arg.dpi_width_bytes }}> stream_out_bytes_{{ arg.ident }}{};
      std::memcpy(stream_out_bytes_{{ arg.ident }}.data(), &dut->{{ arg.sig.tdata }}, {{ arg.width_bytes }});
{% if arg.axis %}
      stream_out_bytes_{{ arg.ident }}[{{ arg.width_bytes }}] = dut->{{ arg.sig.tlast }};
{% endif %}
      (void)tapa_stream_try_write("{{ arg.name }}", stream_out_bytes_{{ arg.ident }}.data());
    }
{% endfor %}
{% endif %}
  }
  dut->ap_clk = 1;
  dut->eval();
  dut->ap_clk = 0;
  dut->eval();
}

static void service_all_axi() {
{% for arg in mmap_args %}
  // ---- AR channel: advertise available queue capacity ----
  dut->{{ arg.axi.arready }} = (int(rd_q_{{ arg.ident }}.size()) < kMaxOutstanding) ? 1 : 0;
  // ---- R channel: serve head of read queue ----
  if (!rd_q_{{ arg.ident }}.empty()) {
    auto& r = rd_q_{{ arg.ident }}.front();
    dut->{{ arg.axi.rvalid }} = 1;
    // Capture each beat once so a concurrent write cannot change stalled data.
    if (!rd_have_data_{{ arg.ident }}) {
      const size_t beat_bytes = size_t{1} << r.size;
      const uint64_t addr = r.addr + (uint64_t)r.beat * beat_bytes;
      const size_t lane = axi_lane("{{ arg.name }}", addr, beat_bytes,
                                   {{ arg.data_width_bytes }});
      std::memset(&dut->{{ arg.axi.rdata }}, 0, sizeof(dut->{{ arg.axi.rdata }}));
      mem_{{ arg.ident }}.read(addr,
                               reinterpret_cast<uint8_t*>(&dut->{{ arg.axi.rdata }}) + lane,
                               beat_bytes);
      dut->{{ arg.axi.rlast }} = (r.beat == r.len) ? 1 : 0;
      dut->{{ arg.axi.rid }} = r.id;
      dut->{{ arg.axi.rresp }} = 0;
      rd_have_data_{{ arg.ident }} = true;
    }
  } else {
    dut->{{ arg.axi.rvalid }} = 0;
  }
  // ---- AW channel: advertise available queue capacity ----
  dut->{{ arg.axi.awready }} = (int(wr_q_{{ arg.ident }}.size()) < kMaxOutstanding) ? 1 : 0;
  // ---- W channel: accept data only after an address is queued ----
  dut->{{ arg.axi.wready }} = !wr_q_{{ arg.ident }}.empty() ? 1 : 0;
  // ---- B channel: respond from completed-write queue ----
  if (!b_q_{{ arg.ident }}.empty()) {
    dut->{{ arg.axi.bvalid }} = 1;
    dut->{{ arg.axi.bid }} = b_q_{{ arg.ident }}.front();
    dut->{{ arg.axi.bresp }} = 0;
  } else {
    dut->{{ arg.axi.bvalid }} = 0;
  }
{% endfor %}
}

{% if mode == "vitis" %}
static void service_streams();
// Set once the kernel starts: register accesses then keep the streams
// moving.
static bool running = false;

static void ctrl_tick() {
  service_all_axi();
  if (running) service_streams();
  tick();
}

static void ctrl_write(uint32_t addr, uint32_t data) {
  dut->s_axi_control_AWVALID = 1;
  dut->s_axi_control_AWADDR = addr;
  dut->s_axi_control_WVALID = 1;
  dut->s_axi_control_WDATA = data;
  dut->s_axi_control_WSTRB = 0xF;
  dut->s_axi_control_BREADY = 1;
  for (int i = 0; i < 20; ++i) {
    ctrl_tick();
    if (dut->s_axi_control_BVALID) break;
  }
  dut->s_axi_control_AWVALID = 0;
  dut->s_axi_control_WVALID = 0;
  dut->s_axi_control_BREADY = 0;
  ctrl_tick();
}
{% if control %}

// The model shows the state after each edge, so each handshake signal is
// read before the edge that takes it.
static uint32_t ctrl_read(uint32_t addr) {
  dut->s_axi_control_ARVALID = 1;
  dut->s_axi_control_ARADDR = addr;
  dut->eval();
  while (!dut->s_axi_control_ARREADY) ctrl_tick();
  ctrl_tick();
  dut->s_axi_control_ARVALID = 0;
  dut->s_axi_control_RREADY = 1;
  dut->eval();
  while (!dut->s_axi_control_RVALID) ctrl_tick();
  const uint32_t data = dut->s_axi_control_RDATA;
  ctrl_tick();
  dut->s_axi_control_RREADY = 0;
  return data;
}

// The host reads and writes registers while the kernel runs (its rings) and
// ends the simulation itself, once it has every frame. Requests are
// {op, offset, value}, little-endian words: op 0 reads, 1 writes, 2
// finishes; each read or write gets a reply {0, value}, and the end of the
// kernel a reply {1, 0}. True once the host has finished.
static bool serve_control() {
  uint8_t request[12];
  while (tapa_ctrl_request(request)) {
    uint32_t words[3];
    std::memcpy(words, request, sizeof(words));
    if (words[0] == 2) return true;
    uint32_t value = words[2];
    if (words[0] == 0) {
      value = ctrl_read(words[1]);
    } else {
      ctrl_write(words[1], value);
    }
    const uint32_t reply[2] = {0, value};
    tapa_ctrl_reply(reinterpret_cast<const uint8_t*>(reply));
  }
  return false;
}
{% endif %}
{% endif %}

static void service_streams() {
{% if mode == "hls" %}
{% for arg in stream_args %}
  stream_in_have_{{ arg.ident }} = tapa_stream_istream_step(
      "{{ arg.name }}",
      stream_in_consumed_{{ arg.ident }},
      stream_in_data_{{ arg.ident }}.data());
  dut->{{ arg.sig.empty_n }} = stream_in_have_{{ arg.ident }} ? 1 : 0;
{% if arg.has_peek %}
  dut->{{ arg.sig.peek_empty_n }} = stream_in_have_{{ arg.ident }} ? 1 : 0;
{% endif %}
  if (stream_in_have_{{ arg.ident }}) {
    std::array<uint8_t, {{ (arg.payload_width_bits + 1).div_ceil(8) }}> packed_{{ arg.ident }}{};
    std::memcpy(packed_{{ arg.ident }}.data(), stream_in_data_{{ arg.ident }}.data(), {{ arg.payload_width_bits.div_ceil(8) }});
{% if arg.payload_width_bits % 8 != 0 %}
    packed_{{ arg.ident }}[{{ arg.payload_width_bits / 8 }}] &= (1u << {{ arg.payload_width_bits % 8 }}) - 1;
{% endif %}
    packed_{{ arg.ident }}[{{ arg.payload_width_bits / 8 }}] |= (stream_in_data_{{ arg.ident }}[{{ arg.width_bytes }}] & 1u) << {{ arg.payload_width_bits % 8 }};
    std::memset(&dut->{{ arg.sig.dout }}, 0, sizeof(dut->{{ arg.sig.dout }}));
    std::memcpy(&dut->{{ arg.sig.dout }}, packed_{{ arg.ident }}.data(), packed_{{ arg.ident }}.size());
{% if arg.has_peek %}
    std::memset(&dut->{{ arg.sig.peek_dout }}, 0, sizeof(dut->{{ arg.sig.peek_dout }}));
    std::memcpy(&dut->{{ arg.sig.peek_dout }}, packed_{{ arg.ident }}.data(), packed_{{ arg.ident }}.size());
{% endif %}
  }
{% endfor %}
{% for arg in stream_out_args %}
  std::array<uint8_t, {{ arg.dpi_width_bytes }}> stream_out_bytes_{{ arg.ident }}{};
  std::memcpy(stream_out_bytes_{{ arg.ident }}.data(), &dut->{{ arg.sig.din }}, {{ arg.payload_width_bits.div_ceil(8) }});
{% if arg.payload_width_bits % 8 != 0 %}
  stream_out_bytes_{{ arg.ident }}[{{ arg.payload_width_bits / 8 }}] &= (1u << {{ arg.payload_width_bits % 8 }}) - 1;
{% endif %}
  stream_out_bytes_{{ arg.ident }}[{{ arg.width_bytes }}] = (reinterpret_cast<const uint8_t*>(&dut->{{ arg.sig.din }})[{{ arg.payload_width_bits / 8 }}] >> {{ arg.payload_width_bits % 8 }}) & 1u;
  dut->{{ arg.sig.full_n }} = tapa_hls_stream_ostream_step("{{ arg.name }}", dut->{{ arg.sig.write }}, stream_out_bytes_{{ arg.ident }}.data()) ? 1 : 0;
{% endfor %}
{% else %}
{% for arg in stream_args %}
  if (!stream_in_have_{{ arg.ident }}) {
    stream_in_have_{{ arg.ident }} = tapa_stream_try_read("{{ arg.name }}", stream_in_data_{{ arg.ident }}.data());
  }
  dut->{{ arg.sig.tvalid }} = stream_in_have_{{ arg.ident }} ? 1 : 0;
{% if arg.axis %}
  dut->{{ arg.sig.tlast }} = stream_in_have_{{ arg.ident }} ? stream_in_data_{{ arg.ident }}[{{ arg.width_bytes }}] : 0;
{% else %}
  dut->{{ arg.sig.tlast }} = 0;
{% endif %}
  if (stream_in_have_{{ arg.ident }}) {
    std::memcpy(&dut->{{ arg.sig.tdata }}, stream_in_data_{{ arg.ident }}.data(), {{ arg.width_bytes }});
  }
{% endfor %}
{% for arg in stream_out_args %}
  bool can_write_{{ arg.ident }} = tapa_stream_can_write("{{ arg.name }}");
  dut->{{ arg.sig.tready }} = can_write_{{ arg.ident }} ? 1 : 0;
{% endfor %}
{% endif %}
}

{% if !stream_out_args.is_empty() %}
// Kernel completion says the kernel logic finished, not that its output left
// the chip: the last beats it wrote can still be sitting in the output FIFOs.
// Keep clocking until every output stream has been quiet for a few cycles, or
// those beats never reach the host and it waits forever.
// Post-completion drain budget: beats leave at one per cycle per stream and
// the host reads concurrently, so the backlog clears in queue-depth cycles;
// anything beyond this is a stuck beat, not a slow one.
static constexpr uint64_t kDrainCycleLimit = 10000000;

static void drain_output_streams() {
  uint64_t drain_cycle_count = 0;
{% if mode == "hls" %}
  // ap_done and ap_ready assert together, so the extra cycles below would
  // start the kernel over if ap_start were still asserted.
  dut->ap_start = 0;
{% endif %}
  // A beat that stays asserted resets the idle count, so a surplus beat the
  // host never reads would drain forever. Bound the total drain instead and
  // name the stuck stream: that is a host/kernel count mismatch, not a hang.
  for (int idle_cycles = 0; idle_cycles < 4;) {
    service_all_axi();
    service_streams();
    tick();
    ++idle_cycles;
    if (++drain_cycle_count > kDrainCycleLimit) {
      std::cerr << "cosim: output stream still has unread beats "
                << kDrainCycleLimit << " cycles after kernel completion:";
{% for arg in stream_out_args %}
{% if mode == "hls" %}
      if (dut->{{ arg.sig.write }}) std::cerr << " {{ arg.name }}";
{% else %}
      if (dut->{{ arg.sig.tvalid }}) std::cerr << " {{ arg.name }}";
{% endif %}
{% endfor %}
      std::cerr << " (host read fewer elements than the kernel wrote)"
                << std::endl;
      exit(EXIT_FAILURE);
    }
{% for arg in stream_out_args %}
{% if mode == "hls" %}
    if (dut->{{ arg.sig.write }}) idle_cycles = 0;
{% else %}
    if (dut->{{ arg.sig.tvalid }}) idle_cycles = 0;
{% endif %}
{% endfor %}
  }
}
{% endif %}

int main(int argc, char** argv) {
  Verilated::commandArgs(argc, argv);
  dut = new V{{ top_name }};

  dut->ap_clk = 0;
  dut->ap_rst_n = 0;
{% if mode == "hls" %}
  dut->ap_start = 0;
{% endif %}
{% if mode == "vitis" %}
  dut->s_axi_control_AWVALID = 0;
  dut->s_axi_control_WVALID = 0;
  dut->s_axi_control_ARVALID = 0;
  dut->s_axi_control_BREADY = 0;
  dut->s_axi_control_RREADY = 0;
{% endif %}
{% for arg in mmap_args %}
  dut->{{ arg.axi.arready }} = 0;
  dut->{{ arg.axi.rvalid }} = 0;
{% if arg.data_width_bytes > 8 %}
  std::memset(&dut->{{ arg.axi.rdata }}, 0, sizeof(dut->{{ arg.axi.rdata }}));
{% else %}
  dut->{{ arg.axi.rdata }} = 0;
{% endif %}
  dut->{{ arg.axi.rlast }} = 0; dut->{{ arg.axi.rid }} = {}; dut->{{ arg.axi.rresp }} = 0;
  dut->{{ arg.axi.awready }} = 0; dut->{{ arg.axi.wready }} = 0;
  dut->{{ arg.axi.bvalid }} = 0; dut->{{ arg.axi.bid }} = {}; dut->{{ arg.axi.bresp }} = 0;
{% endfor %}

  for (int i = 0; i < 10; ++i) tick();
  dut->ap_rst_n = 1;
  for (int i = 0; i < 5; ++i) tick();

{% for arg in mmap_args %}
  mem_{{ arg.ident }}.attach("{{ arg.name }}");
{% endfor %}

{% if mode == "hls" %}
{% for arg in mmap_args %}
  dut->{{ arg.offset_port }} = 0x{{ "{:016x}"|format(arg.base_addr) }}ULL;
{% endfor %}
{% for arg in scalar_args %}
  {
    const uint8_t scalar_bytes[] = { {{ arg.value }} };
    std::memset(&dut->{{ arg.port }}, 0, sizeof(dut->{{ arg.port }}));
    std::memcpy(
        &dut->{{ arg.port }},
        scalar_bytes,
        std::min(sizeof(dut->{{ arg.port }}), sizeof(scalar_bytes)));
  }
{% endfor %}
  dut->ap_start = 1;
  service_all_axi();
  tick();
{% else %}
  ctrl_write(0x04, 1);
  ctrl_write(0x08, 1);
{% for arg in mmap_args %}
  ctrl_write(0x{{ "{:02x}"|format(arg.reg_offset_lo) }}, (uint32_t)(0x{{ "{:016x}"|format(arg.base_addr) }}ULL));
  ctrl_write(0x{{ "{:02x}"|format(arg.reg_offset_hi) }}, (uint32_t)(0x{{ "{:016x}"|format(arg.base_addr) }}ULL >> 32));
{% endfor %}
{% for arg in scalar_args %}
{% for word in arg.words %}
  ctrl_write(0x{{ "{:02x}"|format(word.reg_offset) }}, 0x{{ "{:08x}"|format(word.value_u32) }});
{% endfor %}
{% endfor %}
  ctrl_write(0x00, 1);
  running = true;
{% endif %}
  std::fprintf(stderr, "Kernel started, running simulation...\n");
  std::fprintf(stderr,
               "If this run hangs, bound it with -cosim_timeout_seconds "
               "(FRT_COSIM_TIMEOUT_SECONDS).\n");

  for (uint64_t cycle = 0;; ++cycle) {
    service_all_axi();
    service_streams();
    tick();
{% if mode == "hls" %}
    if (dut->ap_done) {
      std::fprintf(stderr, "Kernel done after %llu cycles\n",
                   static_cast<unsigned long long>(cycle));
      break;
    }
    if (dut->ap_ready) {
      dut->ap_start = 0;
    }
{% else %}
{% if control %}
    if (cycle % 16 == 0) serve_control();
{% endif %}
    if (dut->__SYM__interrupt) {
      std::fprintf(stderr, "Kernel done after %llu cycles\n",
                   static_cast<unsigned long long>(cycle));
      break;
    }
{% endif %}
  }
{% if control %}
  {
    const uint32_t done[2] = {1, 0};
    tapa_ctrl_reply(reinterpret_cast<const uint8_t*>(done));
  }
  for (uint64_t cycle = 0; !(cycle % 16 == 0 && serve_control()); ++cycle) {
    service_all_axi();
    service_streams();
    tick();
  }
{% endif %}

{% if !stream_out_args.is_empty() %}
  drain_output_streams();
{% endif %}

  std::fprintf(stderr, "simulation complete (mode={{ mode }})\n");
  delete dut;
  return 0;
}
