"""FPGA runtime Bazel targets backed by Rust Cargo crates."""

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//bazel:cargo_rules.bzl", "cargo_artifacts", "cargo_platform_artifacts", "cargo_test")

package(default_visibility = ["//visibility:public"])

# `frt-cosim` depends on `//tapa-core:tapa-ir` by relative path, to parse a
# packed archive's `tapa.json` with the same types that wrote it. The glob
# below only covers this package, so the dependency's sources are staged
# explicitly. Cargo loads every workspace member's manifest up front, so this
# is required by *all* the cargo targets here — including the DPI-only ones
# that never compile `frt-cosim`.
_ALL_SRCS = glob(
    ["**/*"],
    exclude = [
        "BUILD.bazel",
        "target/**",
    ],
) + [
    "//tapa-core:tapa-ir-srcs",
    "//tapa-lib:frt-c-api-header",
]

cargo_platform_artifacts(
    name = "cargo_release_artifacts",
    srcs = _ALL_SRCS,
    outs = [
        "cargo/libfrt_dpi_verilator.dylib",
        "cargo/libfrt_dpi_verilator.so",
        "cargo/libfrt_dpi_xsim.dylib",
        "cargo/libfrt_dpi_xsim.so",
    ],
    build_args = [
        "-p",
        "frt-dpi-verilator",
        "-p",
        "frt-dpi-xsim",
    ],
    darwin_artifacts = [
        "libfrt_dpi_verilator.dylib:cargo/libfrt_dpi_verilator.dylib",
        "libfrt_dpi_xsim.dylib:cargo/libfrt_dpi_xsim.dylib",
    ],
    linux_artifacts = [
        "libfrt_dpi_verilator.so:cargo/libfrt_dpi_verilator.so",
        "libfrt_dpi_xsim.so:cargo/libfrt_dpi_xsim.so",
    ],
    local = True,
    manifest = "Cargo.toml",
    tags = ["local"],
)

# The `frt` crate builds as a staticlib (libfrt.a); its filename is identical on
# both platforms, so it uses the non-platform artifact rule rather than the
# dylib/so platform split above.
cargo_artifacts(
    name = "cargo_static_lib",
    srcs = _ALL_SRCS,
    outs = ["cargo/libfrt.a"],
    artifacts = ["libfrt.a:cargo/libfrt.a"],
    build_args = [
        "-p",
        "frt",
    ],
    local = True,
    manifest = "Cargo.toml",
    tags = ["local"],
)

# -- Test: Rust unit tests for the frt workspace --

cargo_test(
    name = "cargo_test",
    size = "enormous",
    srcs = _ALL_SRCS,
    cargo_args = [
        "-p",
        "frt-shm",
        "-p",
        "frt-dpi",
        "-p",
        "frt-dpi-verilator",
        "-p",
        "frt-dpi-xsim",
        "-p",
        "frt-cosim",
        "-p",
        "frt",
    ],
    cargo_env_files = {
        "@verilator//:verilator_executable": "VERILATOR_BIN",
    },
    manifest = "Cargo.toml",
    tags = [
        "cpu:8",
        "requires-network",
    ],
)

# The Rust FRT is embedded privately and statically into libtapa. alwayslink
# pulls in every object so the full frt_instance_*/frt_shmq_* C ABI is available
# to tapa-lib even though only a subset is referenced from any one translation
# unit.
cc_import(
    name = "frt_rust_staticlib",
    static_library = "cargo/libfrt.a",
    alwayslink = True,
)

# Wrapper carrying the native system libraries the Rust staticlib depends on
# (from `rustc --print native-static-libs`). FRT's symbols are not hidden: the
# shipped artifact is the static libtapa.a (no export table to filter), and
# --exclude-libs breaks resolution across Bazel's internal libtapa.so DSO.
#
# No `-lOpenCL`: `cl3` (under `opencl3`) enables its `dynamic` feature by
# default and dlopens the ICD loader on first use, so nothing here references
# an OpenCL symbol at link time. Listing it would make software simulation —
# which never touches OpenCL — fail to link on a machine with no ICD loader
# installed.
cc_library(
    name = "frt",
    linkopts = select({
        "//bazel:is_macos": [
            "-liconv",
        ],
        "//conditions:default": [
            "-lpthread",
            "-ldl",
            "-lrt",
            "-lm",
        ],
    }),
    deps = [":frt_rust_staticlib"],
)

# FRT ships as a static archive (libfrt.a) that host links pull in privately;
# no shared libfrt.so. The DPI plugins remain shared objects (dlopened by the
# simulators at runtime).
pkg_files(
    name = "pkg-lib",
    srcs = [
        "cargo/libfrt.a",
        "cargo/libfrt_dpi_verilator.so",
        "cargo/libfrt_dpi_xsim.so",
    ],
    prefix = "usr/lib",
    strip_prefix = strip_prefix.files_only(),
    target_compatible_with = ["@platforms//os:linux"],
)

pkg_files(
    name = "pkg-extra-runtime-deps",
    srcs = [
        "@gflags",
        "@glog",
    ],
    prefix = "usr/lib",
    strip_prefix = strip_prefix.files_only(),
    target_compatible_with = ["@platforms//os:linux"],
)

pkg_filegroup(
    name = "pkg",
    srcs = [
        ":pkg-lib",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

pkg_filegroup(
    name = "pkg-portable",
    srcs = [
        ":pkg",
        ":pkg-extra-runtime-deps",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
