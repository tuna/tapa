"""FPGA runtime Bazel targets backed by Rust Cargo crates."""

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library", "cc_test")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//bazel:cargo_rules.bzl", "cargo_platform_artifacts", "cargo_test")

package(default_visibility = ["//visibility:public"])

_PUBLIC_HEADERS = [
    "frt.h",
    "frt/arg_info.h",
    "frt/buffer.h",
    "frt/buffer_arg.h",
    "frt/stream.h",
    "frt/stream_arg.h",
    "frt/stringify.h",
    "frt/tag.h",
]

cargo_platform_artifacts(
    name = "cargo_release_artifacts",
    srcs = glob(
        ["**/*"],
        exclude = [
            "BUILD.bazel",
            "target/**",
        ],
    ),
    outs = [
        "cargo/libfrt.dylib",
        "cargo/libfrt.so",
        "cargo/libfrt_dpi_verilator.dylib",
        "cargo/libfrt_dpi_verilator.so",
        "cargo/libfrt_dpi_xsim.dylib",
        "cargo/libfrt_dpi_xsim.so",
    ],
    build_args = [
        "-p",
        "frt",
        "-p",
        "frt-dpi-verilator",
        "-p",
        "frt-dpi-xsim",
    ],
    darwin_artifacts = [
        "libfrt.dylib:cargo/libfrt.dylib",
        "libfrt_dpi_verilator.dylib:cargo/libfrt_dpi_verilator.dylib",
        "libfrt_dpi_xsim.dylib:cargo/libfrt_dpi_xsim.dylib",
    ],
    linux_artifacts = [
        "libfrt.so:cargo/libfrt.so",
        "libfrt_dpi_verilator.so:cargo/libfrt_dpi_verilator.so",
        "libfrt_dpi_xsim.so:cargo/libfrt_dpi_xsim.so",
    ],
    local = True,
    manifest = "Cargo.toml",
    tags = ["local"],
)

# -- Test: Rust unit tests for the frt workspace --

cargo_test(
    name = "cargo_test",
    size = "enormous",
    srcs = glob(
        ["**/*"],
        exclude = [
            "BUILD.bazel",
            "target/**",
        ],
    ),
    cargo_args = [
        "-p",
        "frt-shm",
        "-p",
        "frt-dpi",
        "-p",
        "frt-dpi-verilator",
        "-p",
        "frt-dpi-xsim",
        "-p",
        "frt-cosim",
        "-p",
        "frt",
    ],
    cargo_env_files = {
        "@verilator//:verilator_executable": "VERILATOR_BIN",
    },
    manifest = "Cargo.toml",
    tags = [
        "cpu:8",
        "requires-network",
    ],
)

cc_import(
    name = "frt_rust_cdylib",
    shared_library = select({
        "//bazel:is_macos": "cargo/libfrt.dylib",
        "//conditions:default": "cargo/libfrt.so",
    }),
)

cc_library(
    name = "frt",
    srcs = [
        "frt_compat.cpp",
    ],
    hdrs = _PUBLIC_HEADERS,
    includes = ["."],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":frt_rust_cdylib",
        "@glog",
    ],
)

cc_library(
    name = "frt_cpp",
    srcs = ["frt_compat.cpp"],
    hdrs = _PUBLIC_HEADERS,
    includes = ["."],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":frt_rust_cdylib",
        "@glog",
    ],
)

cc_library(
    name = "frt-sim",
    srcs = ["frt_compat.cpp"],
    hdrs = _PUBLIC_HEADERS,
    includes = ["."],
    deps = [
        ":frt_rust_cdylib",
        "@glog",
    ],
)

# The test links frt_compat.cpp in its own compilation unit to avoid
# lld link-order issues with mixed static/dynamic deps from frt_cpp.
cc_test(
    name = "frt-compat-env-test",
    size = "small",
    srcs = ["frt_compat_env_test.cpp"],
    # TODO(hnkor): lld + toolchains_llvm ignores alwayslink for frt_cpp,
    # causing ForwardFlagsToEnvForTest to be an undefined symbol.
    # Tracked as a known issue; run manually with: bazel test //fpga-runtime:frt-compat-env-test
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":frt_cpp",
        "//tapa-lib:scoped_set_env",
        "@gflags",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

filegroup(
    name = "include",
    srcs = _PUBLIC_HEADERS,
)

pkg_files(
    name = "pkg-lib",
    srcs = [
        "cargo/libfrt.so",
        "cargo/libfrt_dpi_verilator.so",
        "cargo/libfrt_dpi_xsim.so",
        ":frt_cpp",
    ],
    prefix = "usr/lib",
    strip_prefix = strip_prefix.files_only(),
    target_compatible_with = ["@platforms//os:linux"],
)

pkg_files(
    name = "pkg-include",
    srcs = [":include"],
    prefix = "usr/include",
    strip_prefix = strip_prefix.from_pkg(""),
)

pkg_files(
    name = "pkg-extra-runtime-deps",
    srcs = [
        "@gflags",
        "@glog",
    ],
    prefix = "usr/lib",
    strip_prefix = strip_prefix.files_only(),
    target_compatible_with = ["@platforms//os:linux"],
)

pkg_filegroup(
    name = "pkg",
    srcs = [
        ":pkg-include",
        ":pkg-lib",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

pkg_filegroup(
    name = "pkg-portable",
    srcs = [
        ":pkg",
        ":pkg-extra-runtime-deps",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
