load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("@vitis_hls//:defs.bzl", "VITIS_HLS_AVAILABLE")
load("//bazel:header_extractor.bzl", "header_extractor")

bool_flag(
    name = "enable_coroutine",
    build_setting_default = True,  # Enable with `--//tapa-lib:tapa_enable_coroutine`
)

config_setting(
    name = "coroutine_enabled",
    flag_values = {":enable_coroutine": "True"},
)

_PUBLIC_HEADERS = [
    "tapa.h",
    "tapa/base/axis.h",
    "tapa/base/fixed.h",
    "tapa/base/logging.h",
    "tapa/base/logging_dummy.h",
    "tapa/base/int.h",
    "tapa/base/stream.h",
    "tapa/base/tapa.h",
    "tapa/base/task.h",
    "tapa/base/util.h",
    "tapa/base/vec.h",
    "tapa/compat.h",
    "tapa/host/axis.h",
    "tapa/host/fixed.h",
    "tapa/host/coroutine.h",
    "tapa/host/frt/c_api.h",
    "tapa/host/frt/instance.h",
    "tapa/host/frt/stream.h",
    "tapa/host/frt/types.h",
    "tapa/host/logging.h",
    "tapa/host/mmap.h",
    "tapa/host/stream.h",
    "tapa/host/tapa.h",
    "tapa/host/task.h",
    "tapa/host/util.h",
    "tapa/host/vec.h",
    "tapa/stub/axis.h",
    "tapa/stub/fixed.h",
    "tapa/stub/logging.h",
    "tapa/stub/mmap.h",
    "tapa/stub/stream.h",
    "tapa/stub/tapa.h",
    "tapa/stub/task.h",
    "tapa/stub/util.h",
    "tapa/stub/vec.h",
    "tapa/xilinx/hls/axis.h",
    "tapa/xilinx/hls/fixed.h",
    "tapa/xilinx/hls/logging.h",
    "tapa/xilinx/hls/mmap.h",
    "tapa/xilinx/hls/int.h",
    "tapa/xilinx/hls/stream.h",
    "tapa/xilinx/hls/tapa.h",
    "tapa/xilinx/hls/task.h",
    "tapa/xilinx/hls/util.h",
    "tapa/xilinx/hls/vec.h",
