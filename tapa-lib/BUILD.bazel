# Shared sources between :tapa (full sim) and :tapa-sim (lean sim).
_TAPA_COPTS = [
    # Suppress warnings from Boost headers redefining their own macros
    "-Wno-macro-redefined",
]

_TAPA_DEPS = [
    "//fpga-runtime:frt",
    "@gflags",
    "@glog",
]

_SHARED_SRCS = [
    "tapa/host/frt/flags.cpp",
    "tapa/host/frt/instance.cpp",
    "tapa/host/private_util.cpp",
    "tapa/host/private_util.h",
    "tapa/host/stream.cpp",
    "tapa/host/task.cpp",
]

filegroup(
    name = "frt-c-api-header",
    srcs = ["tapa/host/frt/c_api.h"],
    visibility = ["//fpga-runtime:__pkg__"],
)

cc_library(
    name = "tapa",
    srcs = _SHARED_SRCS + ["tapa/host/private_scheduler.h"],
    hdrs = _PUBLIC_HEADERS,
    copts = _TAPA_COPTS,
    includes = ["."],
    local_defines = select({
        ":coroutine_enabled": ["TAPA_ENABLE_COROUTINE"],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = _TAPA_DEPS + [
        "@boost//:coroutine2",
        "@boost//:thread",
    ],
)

alias(
    name = "tapa-host",
    actual = select({
        "//bazel:is_macos": ":tapa-sim",
        "//conditions:default": ":tapa",
    }),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "tapa-sim",
    srcs = _SHARED_SRCS,
    hdrs = _PUBLIC_HEADERS,
    copts = _TAPA_COPTS,
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = _TAPA_DEPS,
)

cc_test(
    name = "tapa-sim-test",
    size = "small",
    srcs = ["tapa/host/sim_test.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        ":tapa-sim",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "scoped_set_env",
    hdrs = ["tapa/scoped_set_env.h"],
    includes = ["."],
    deps = [
        "@glog",
    ],
)

cc_library(
    name = "scoped_log_sink_mock",
    testonly = True,
    hdrs = ["tapa/scoped_log_sink_mock.h"],
    deps = [
        "@glog",
        "@googletest//:gtest",
    ],
)

cc_test(
    name = "tapa-lib-test",
    size = "small",
    # `flags_test.cpp` has its own focused target (`:frt-flags-test`) so it is
    # not swept into this catch-all test. `stream_alloc_test.cpp` replaces the
    # global allocation functions, which is process-wide, so it gets its own
    # target too (`:stream-alloc-test`), as does `stall_test.cpp`, which needs
    # the stall threshold in the environment before the first blocked poll
    # reads it (`:stall-test`).
    srcs = glob(
        ["tapa/**/*_test.cpp"],
        exclude = [
            "tapa/host/frt/flags_test.cpp",
            "tapa/host/stall_test.cpp",
            "tapa/host/stream_alloc_test.cpp",
            "tapa/vendor_parity_test.cpp",
        ],
    ),
    linkopts = ["-lstdc++fs"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        ":scoped_log_sink_mock",
        ":scoped_set_env",
        ":tapa",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# The vendor headers are an optional dependency, and where Xilinx is not
# installed `@vitis_hls//:include` is an EMPTY cc_library -- the test would
# compile, run nothing, and report PASSED, which is indistinguishable from
# having checked. So the target declares itself incompatible instead and
# Bazel reports it as SKIPPED, which is what actually happened.
#
# Kept out of `:tapa-lib-test` so the catch-all target does not grow a
# vendor dep.
cc_test(
    name = "vendor-parity-test",
    size = "small",
    srcs = ["tapa/vendor_parity_test.cpp"],
    target_compatible_with = ["@platforms//os:linux"] if VITIS_HLS_AVAILABLE else ["@platforms//:incompatible"],
    visibility = ["//visibility:public"],
    deps = [
        ":tapa",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@vitis_hls//:include",
    ],
)

# `stall_warn_threshold_ns` caches the env var the first time any blocked poll
# reads it, so the threshold has to be in place before the process starts
# rather than set from inside a test.
cc_test(
    name = "stall-test",
    size = "small",
    srcs = ["tapa/host/stall_test.cpp"],
    env = {"TAPA_STALL_WARN_SECONDS": "0.05"},
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        ":scoped_log_sink_mock",
        ":tapa",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "stream-alloc-test",
    size = "small",
    srcs = ["tapa/host/stream_alloc_test.cpp"],
    # Wall-clock bounds on scheduler backoff are load-sensitive: under CPU
    # saturation a blocked poll legitimately reaches the 1 ms rung, so let
    # Bazel retry rather than flake the suite. The bound still bites on a
    # quiet runner, which is where the regression would show.
    flaky = True,
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        ":tapa",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

# The same guard against `:tapa-sim`, which builds without coroutines and so
# takes the thread-per-task scheduler -- the default on macOS, and the
# configuration where a blocked poll used to sleep a millisecond.
cc_test(
    name = "stream-alloc-test-sim",
    size = "small",
    srcs = ["tapa/host/stream_alloc_test.cpp"],
    # Same load sensitivity as stream-alloc-test, in the non-coroutine
    # scheduler where the backoff matters most.
    flaky = True,
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        ":tapa-sim",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "frt-flags-test",
    size = "small",
    srcs = ["tapa/host/frt/flags_test.cpp"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [
        ":scoped_set_env",
        ":tapa",
        "@gflags",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

filegroup(
    name = "include",
    srcs = _PUBLIC_HEADERS,
    visibility = ["//visibility:public"],
)

header_extractor(
    name = "extra-runtime-include",
    visibility = ["//visibility:public"],
    deps = ["@glog"],
)

pkg_files(
    name = "pkg-lib",
    srcs = [":tapa"],
    prefix = "usr/lib",
    strip_prefix = strip_prefix.files_only(),
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "pkg-include",
    srcs = [":include"],
    prefix = "usr/include",
    strip_prefix = strip_prefix.from_pkg(),
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "pkg-extra-runtime-include",
    srcs = [":extra-runtime-include"],
    prefix = "usr/include",
    strip_prefix = strip_prefix.from_pkg("extra-runtime-include"),
    visibility = ["//visibility:public"],
)

pkg_files(
    name = "pkg-extra-runtime-deps",
    srcs = [
        "@boost//:context",  # for boost.coroutine2
        "@boost//:thread",
        # gflags/glog ship via //fpga-runtime:pkg-extra-runtime-deps.
    ],
    prefix = "usr/lib",
    strip_prefix = strip_prefix.files_only(),
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "pkg",
    srcs = [
        ":pkg-include",
        ":pkg-lib",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "pkg-portable",
    srcs = [
        ":pkg",
        ":pkg-extra-runtime-deps",
        ":pkg-extra-runtime-include",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)
