"""TAPA core Rust crates — Bazel build via Cargo."""

load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(
    "@vars//:vars.bzl",
    "REMOTE_HOST",
    "REMOTE_KEY_FILE",
    "REMOTE_PORT",
    "REMOTE_SSH_CONTROL_DIR",
    "REMOTE_SSH_CONTROL_PERSIST",
    "REMOTE_USER",
    "REMOTE_XILINX_SETTINGS",
    "REMOTE_XILINX_TOOL_PATH",
    "XILINX_TOOL_VERSION",
)
load("//bazel:cargo_rules.bzl", "cargo_artifacts", "cargo_test")
load("//bazel:xilinx_versions.bzl", "vitis_layout_subdir")

exports_files([
    "tapa-codegen/assets/verilog/axis_adapter.v",
    "tapa-codegen/assets/verilog/fifo.v",
    "tapa-codegen/assets/verilog/fifo_bram.v",
    "tapa-codegen/assets/verilog/fifo_fwd.v",
    "tapa-codegen/assets/verilog/fifo_srl.v",
])

_ALL_SRCS = glob(
    ["**/*"],
    exclude = [
        "BUILD.bazel",
        "target/**",
    ],
) + [
    # Version file outside `tapa-core/`; the Verilog templates live
    # under `tapa-core/assets` and are covered by the glob above.
    "//:VERSION",
]

# -- Schema sources for the neighboring `fpga-runtime` Cargo workspace --
# `frt-cosim` reads the `tapa.json` entry out of a packed archive using the
# very `tapa-ir` types `tapa pack` wrote it from. The dependency is declared
# once in `fpga-runtime/Cargo.toml` as `tapa-ir = { path = "../tapa-core/tapa-ir" }`
# (crates take it as `{ workspace = true }`), so it is anchored at
# `fpga-runtime/` -- one `..`. `//fpga-runtime`'s cargo targets glob only their
# own package, so without this those files are absent from the sandbox and
# Cargo cannot load the dependency's manifest. Bazel stages inputs at their
# repo-relative paths in the execroot, which is exactly where that relative
# path resolves from `fpga-runtime/`.
#
# `Cargo.toml` (this workspace's root) must come along: `tapa-ir/Cargo.toml`
# inherits its dependencies and lint table from it, and Cargo refuses to load
# the manifest without a workspace root to inherit from. Verified that the
# root manifest is *all* it needs — Cargo does not load this workspace's other
# members to satisfy a foreign path dependency.
#
# Every `//fpga-runtime` cargo target needs this, not just the ones that
# compile `frt-cosim`: Cargo loads *all* workspace members' manifests up front,
# so even `-p frt-dpi-verilator` (which has no dependency on `frt-cosim`) fails
# without it.
filegroup(
    name = "tapa-ir-srcs",
    srcs = ["Cargo.toml"] + glob(
        ["tapa-ir/**"],
        exclude = ["tapa-ir/target/**"],
    ),
    visibility = ["//fpga-runtime:__pkg__"],
)

_REMOTE_XILINX_SETTINGS = REMOTE_XILINX_SETTINGS or (
    REMOTE_XILINX_TOOL_PATH +
    vitis_layout_subdir(XILINX_TOOL_VERSION) +
    XILINX_TOOL_VERSION +
    "/settings64.sh" if REMOTE_XILINX_TOOL_PATH else ""
)

# -- Build: library crates only (Cargo backed by the rules_rust toolchain) --
# Builds the workspace's pure-Rust library crates.

# One invocation compiles the shared dependency tree once for the three
# library crates and the `tapa` binary (previously two actions each
# recompiled the same ~200-crate tree from scratch).
cargo_artifacts(
    name = "cargo_build",
    srcs = _ALL_SRCS,
    outs = [
        "cargo/bin/tapa",
        "cargo/libtapa_ir.rlib",
        "cargo/libtapa_protocol.rlib",
        "cargo/libtapa_rtl.rlib",
    ],
    artifacts = [
        "libtapa_protocol.rlib:cargo/libtapa_protocol.rlib",
        "libtapa_ir.rlib:cargo/libtapa_ir.rlib",
        "libtapa_rtl.rlib:cargo/libtapa_rtl.rlib",
        "tapa:cargo/bin/tapa",
    ],
    build_args = [
        "-p",
        "tapa-protocol",
        "-p",
        "tapa-ir",
        "-p",
        "tapa-rtl",
        "-p",
        "tapa-cli",
    ],
    executable_outputs = ["cargo/bin/tapa"],
    manifest = "Cargo.toml",
    tags = ["requires-network"],
    visibility = ["//visibility:public"],
)

# Downstream packagers consume this via `//tapa-core:tapa-cli` and install it
# directly as `usr/bin/tapa`; same outputs as the merged build action.
alias(
    name = "tapa-cli",
    actual = ":cargo_build",
    visibility = ["//visibility:public"],
)

# -- Command wrapper with full runtime runfiles --
# Bazel rules and tests execute `//tapa-core:tapa`, which delegates to
# the Rust `tapa-cli` binary while staging sibling tools and headers
# that `tapa-cli` discovers by walking up from its runfiles path.

sh_binary(
    name = "tapa",
    srcs = ["tapa_wrapper.sh"],
    data = [
        ":tapa-cli",
        "//tapa-cpp:gen-tapa-cpp",
        "//tapa-lib:extra-runtime-include",
        "//tapa-lib:include",
        "//tapa-system-include",
        "//tapacc",
    ] + select({
        # The runtime libraries and extra runtime include are Linux-only
        # in their defining packages, so keep them behind the same platform
        # guard used by those packages.
        "@platforms//os:linux": [
            "//fpga-runtime:pkg-extra-runtime-deps",
            "//fpga-runtime:pkg-lib",
            "//tapa-lib:pkg-extra-runtime-deps",
            "//tapa-lib:pkg-lib",
            "//tapa-system-include:tapa-extra-runtime-include",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "tapa_wrapper_test",
    srcs = ["tapa_wrapper_test.sh"],
    data = ["tapa_wrapper.sh"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Ship the native Rust `tapa` binary directly as `/usr/bin/tapa`.

# References the single binary output of `:cargo_build` directly:
# `rules_pkg` requires rename sources to expand to exactly one file.
pkg_files(
    name = "pkg-bin",
    srcs = ["cargo/bin/tapa"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "usr/bin",
    renames = {"//tapa-core:cargo/bin/tapa": "tapa"},
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "pkg",
    srcs = [":pkg-bin"],
    visibility = ["//visibility:public"],
)

CARGO_TEST_PACKAGES = [
    "-p",
    "tapa-protocol",
    "-p",
    "tapa-ir",
    "-p",
    "tapa-rtl",
    "-p",
    "tapa-codegen",
    "-p",
    "tapa-xilinx",
    "-p",
    "tapa-floorplan",
    "-p",
    "tapa-cli",
]

# -- Test: Rust unit and integration tests --

cargo_test(
    name = "cargo_test",
    size = "enormous",
    srcs = _ALL_SRCS,
    cargo_args = CARGO_TEST_PACKAGES,
    cargo_env_files = {
        # Hermetic verilator for the tapa-codegen cosim tests; without
        # it they probe `verilator` on PATH and skip when absent.
        "@verilator//:verilator_executable": "VERILATOR_BIN",
    },
    manifest = "Cargo.toml",
    tags = [
        "cpu:8",
        "requires-network",
    ],
)

# -- Test: tapacc ↔ tapa-ir schema conformance --
# The guard that the C++ producer (`//tapacc`) still speaks the schema the
# Rust consumer (`tapa-ir`) parses. Every other schema test reads a
# hand-written fixture, so none of them can see the two sides drift apart;
# this one runs the real `tapacc` (via the production `tapa analyze`
# invocation, which stages Clang's resource dir and the TAPA include cascade)
# and strict-parses its verbatim stdout. `//tapacc` is a Clang tool that only
# builds on Linux, hence the platform gate.
#
# The test itself lives in `tapa-cli/tests/tapacc_conformance.rs` and skips
# when these env vars are absent, so it is inert under plain `cargo test` and
# under `:cargo_test` above. `TAPA_CONFORMANCE_REQUIRED` turns that skip into
# a failure here, so a drifted `cargo_env` block cannot silently disable it.

cargo_test(
    name = "tapacc_conformance_test",
    size = "large",
    srcs = _ALL_SRCS,
    cargo_args = [
        "-p",
        "tapa-cli",
        "--test",
        "tapacc_conformance",
    ],
    cargo_env = {
        "TAPA_CONFORMANCE_REQUIRED": "1",
        # Runfiles-relative paths; the test resolves them against
        # `RUNFILES_DIR` / `TEST_SRCDIR`.
        "TAPA_CONFORMANCE_TAPA": "tapa-core/tapa",
        "TAPA_CONFORMANCE_VADD": "tests/apps/vadd/vadd.cpp",
        "TAPA_CONFORMANCE_ASYNC_MMAP": "tests/apps/async_mmap/async_mmap.cpp",
        "TAPA_CONFORMANCE_TEMPLATED": "tests/apps/templated/templated.cpp",
        "TAPA_CONFORMANCE_IGNORE": "tests/apps/ignore/ignore.cpp",
    },
    data = [
        # Brings `//tapacc`, `//tapa-cpp`, and the system includes along as
        # its own runfiles — the same tree a real `tapa analyze` walks.
        ":tapa",
        "//tests/apps/vadd:vadd.cpp",
        # Included by vadd.cpp; must sit beside it in the runfiles tree.
        "//tests/apps/vadd:vadd.h",
        # Conformance corpus: async_mmap, template-specialization, ignore.
        "//tests/apps/async_mmap:async_mmap.cpp",
        "//tests/apps/templated:templated.cpp",
        "//tests/apps/ignore:ignore.cpp",
    ],
    manifest = "Cargo.toml",
    tags = [
        "cpu:4",
        "requires-network",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

# -- Test: gated tapa-xilinx integration suite (manual) --
# Imports configured REMOTE_* values and runs `cargo test -p tapa-xilinx -- --ignored`.
# Tagged `manual` so default CI runs remain unblocked.

cargo_test(
    name = "tapa_xilinx_integration_test",
    srcs = _ALL_SRCS,
    cargo_args = [
        "-p",
        "tapa-xilinx",
    ],
    cargo_env = {
        "REMOTE_HOST": REMOTE_HOST,
        "REMOTE_PORT": REMOTE_PORT,
        "REMOTE_SSH_CONTROL_DIR": REMOTE_SSH_CONTROL_DIR,
        "REMOTE_SSH_CONTROL_PERSIST": REMOTE_SSH_CONTROL_PERSIST,
        "REMOTE_USER": REMOTE_USER,
        "REMOTE_XILINX_SETTINGS": _REMOTE_XILINX_SETTINGS,
        "REMOTE_XILINX_TOOL_PATH": REMOTE_XILINX_TOOL_PATH,
    },
    cargo_env_files = {
        "@ssh_key//:key": "REMOTE_KEY_FILE",
    } if REMOTE_KEY_FILE else {},
    manifest = "Cargo.toml",
    skip_without_xilinx_env = True,
    tags = ["manual"],
    test_args = [
        "--",
        "--ignored",
    ],
)
