"""TAPA core Rust crates — Bazel build via Cargo."""

load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_filegroup", "pkg_files", "pkg_mklink")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:cargo_rules.bzl", "cargo_artifacts")

exports_files([
    "tapa-codegen/assets/verilog/axis_adapter.v",
    "tapa-codegen/assets/verilog/fifo.v",
    "tapa-codegen/assets/verilog/fifo_bram.v",
    "tapa-codegen/assets/verilog/fifo_fwd.v",
    "tapa-codegen/assets/verilog/fifo_srl.v",
])

_ALL_SRCS = glob(
    ["**/*"],
    exclude = [
        "BUILD.bazel",
        "target/**",
    ],
) + [
    # Version file outside `tapa-core/`; the Verilog templates live
    # under `tapa-core/assets` and are covered by the glob above.
    "//:VERSION",
]

# -- Build: library crates only (Cargo backed by the rules_rust toolchain) --
# Builds the workspace's pure-Rust library crates.

cargo_artifacts(
    name = "cargo_build",
    srcs = _ALL_SRCS,
    outs = [
        "cargo/libtapa_graphir.rlib",
        "cargo/libtapa_protocol.rlib",
        "cargo/libtapa_rtl.rlib",
        "cargo/libtapa_task_graph.rlib",
        "cargo/libtapa_topology.rlib",
    ],
    artifacts = [
        "libtapa_protocol.rlib:cargo/libtapa_protocol.rlib",
        "libtapa_task_graph.rlib:cargo/libtapa_task_graph.rlib",
        "libtapa_graphir.rlib:cargo/libtapa_graphir.rlib",
        "libtapa_rtl.rlib:cargo/libtapa_rtl.rlib",
        "libtapa_topology.rlib:cargo/libtapa_topology.rlib",
    ],
    build_args = [
        "-p",
        "tapa-protocol",
        "-p",
        "tapa-task-graph",
        "-p",
        "tapa-graphir",
        "-p",
        "tapa-rtl",
        "-p",
        "tapa-topology",
    ],
    manifest = "Cargo.toml",
    tags = ["requires-network"],
    visibility = ["//visibility:public"],
)

# -- Build: native `tapa-cli` binary --
# Same Cargo invocation pattern as `cargo_build`.
# Downstream packagers consume this via `//tapa-core:tapa-cli` and re-wrap as
# `usr/share/tapa/runtime/tapa` + `usr/bin/tapa` symlink.

cargo_artifacts(
    name = "tapa-cli",
    srcs = _ALL_SRCS,
    outs = ["cargo/bin/tapa"],
    artifacts = ["tapa:cargo/bin/tapa"],
    build_args = [
        "-p",
        "tapa-cli",
        "--bin",
        "tapa",
    ],
    executable = True,
    executable_outputs = ["cargo/bin/tapa"],
    manifest = "Cargo.toml",
    tags = ["requires-network"],
    visibility = ["//visibility:public"],
)

# -- Command wrapper with full runtime runfiles --
# Bazel rules and tests execute `//tapa-core:tapa`, which delegates to
# the Rust `tapa-cli` binary while staging sibling tools and headers
# that `tapa-cli` discovers by walking up from its runfiles path.

sh_binary(
    name = "tapa",
    srcs = ["tapa_wrapper.sh"],
    data = [
        ":tapa-cli",
        "//fpga-runtime:include",
        "//tapa-cpp:gen-tapa-cpp",
        "//tapa-lib:extra-runtime-include",
        "//tapa-lib:include",
        "//tapa-system-include",
        "//tapacc",
    ] + select({
        # The runtime libraries and extra runtime include are Linux-only
        # in their defining packages, so keep them behind the same platform
        # guard used by those packages.
        "@platforms//os:linux": [
            "//fpga-runtime:pkg-extra-runtime-deps",
            "//fpga-runtime:pkg-lib",
            "//tapa-lib:pkg-extra-runtime-deps",
            "//tapa-lib:pkg-lib",
            "//tapa-system-include:tapa-extra-runtime-include",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Ship the native Rust `tapa` binary as `usr/share/tapa/runtime/tapa`;
# `/usr/bin/tapa` is a symlink to that binary in the assembled package.

pkg_files(
    name = "pkg-runtime",
    srcs = [":tapa-cli"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "usr/share/tapa/runtime",
    renames = {"//tapa-core:tapa-cli": "tapa"},
    visibility = ["//visibility:public"],
)

pkg_mklink(
    name = "pkg-link",
    link_name = "usr/bin/tapa",
    target = "../share/tapa/runtime/tapa",
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "pkg",
    srcs = [
        ":pkg-link",
        ":pkg-runtime",
    ],
    visibility = ["//visibility:public"],
)

# -- Test: Rust unit and integration tests (manual, requires system cargo) --

sh_test(
    name = "cargo_test",
    srcs = ["run_cargo_test.sh"],
    data = _ALL_SRCS + [
        "@rules_rust//rust/toolchain:current_cargo_files",
        "@rules_rust//rust/toolchain:current_rustc_files",
        "@rules_rust//rust/toolchain:current_rustdoc_files",
    ],
    env = {
        "CARGO_MANIFEST_DIR": "tapa-core",
    },
    tags = ["manual"],
)

# -- Test: gated tapa-xilinx integration suite (manual) --
# Reads VARS.local.bzl-style REMOTE_* env vars; runs `cargo test
# -p tapa-xilinx -- --ignored`. Tagged `manual` so default CI
# runs remain unblocked.

sh_test(
    name = "tapa_xilinx_integration_test",
    srcs = ["run_xilinx_integration_test.sh"],
    data = _ALL_SRCS + [
        "@rules_rust//rust/toolchain:current_cargo_files",
        "@rules_rust//rust/toolchain:current_rustc_files",
        "@rules_rust//rust/toolchain:current_rustdoc_files",
    ],
    env = {
        "CARGO_MANIFEST_DIR": "tapa-core",
    },
    tags = ["manual"],
)
