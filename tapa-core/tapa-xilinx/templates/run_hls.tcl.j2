cd [pwd]
open_project "project"
set_top {{ top }}
for {set i 0} {$i < $::env(TAPA_KERNEL_COUNT)} {incr i} {
    set kpath [set ::env(TAPA_KERNEL_PATH_$i)]
    set kcflags [set ::env(TAPA_KERNEL_CFLAGS_$i)]
    add_files "$kpath" -cflags "$kcflags"
}
open_solution "{{ solution }}"
set_part {{ part }}
create_clock -period {{ clock }} -name default
config_compile -name_max_length 253
# Every buffer a kernel is given starts on a 64-byte boundary (XRT pages,
# cosimulation), so an element is read without realigning it.
config_interface -m_axi_addr64 -m_axi_alignment_byte_size 64
{% if !other.is_empty() %}{{ other }}{% endif %}
set_param hls.enable_hidden_option_error false
config_rtl -reset_level low -module_auto_prefix
config_rtl -enableFreeRunPipeline=false
config_rtl -disableAutoFreeRunPipeline=true
csynth_design
exit
