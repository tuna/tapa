set hdl_dir [lindex $argv 0]
set rpt_file [lindex $argv 1]
set_param general.maxThreads 1
set_part {{ part_num }}
read_verilog [ glob $hdl_dir/*.v ]
set ips [ glob -nocomplain $hdl_dir/*/*.xci ]
if { $ips ne "" } {
  import_ip $ips
  upgrade_ip [get_ips *]
}
foreach tcl_file [glob -nocomplain $hdl_dir/*.tcl] {
  source $tcl_file
}
set ip_files [get_files -quiet *.xci]
if { $ip_files ne "" } {
  # Include generated IP logic in this task's resource estimate instead of
  # requiring separate out-of-context checkpoints (e.g. HLS divider IP).
  set_property generate_synth_checkpoint false $ip_files
  generate_target synthesis $ip_files
}
synth_design {{ synth_args }}
opt_design
report_utilization -file $rpt_file {{ report_util_args }}
