set -e

TARGET=${TARGET:-hw}
# TARGET=hw_emu ./this-script.sh
# DEBUG=-g

TOP={{ top }}
XO={{ xo }}
{% if let Some((libadf, aie_cfg)) = aie %}
# The AI Engine graph and the PLIO connectivity of the kernel's AXIS ports.
# A Versal link produces an .xsa that `v++ --package` turns into the xclbin.
LIBADF={{ libadf }}
AIE_CFG={{ aie_cfg }}
{% endif %}
{% if let Some(target_frequency) = target_frequency %}TARGET_FREQUENCY={{ target_frequency }}
{% else %}
>&2 echo "Using the default clock target of the platform."
{% endif %}
{% if let Some(platform) = platform %}PLATFORM={{ platform }}
{% else %}PLATFORM=""
if [ -z "${PLATFORM}" ]; then echo 'Please edit this file and set a valid PLATFORM= on line "${LINENO}"'; exit; fi

{% endif %}
OUTPUT_DIR="$(pwd)/vitis_run_${TARGET}"

MAX_SYNTH_JOBS=8
STRATEGY="Explore"
PLACEMENT_STRATEGY="EarlyBlockPlacement"

v++ ${DEBUG} \
  --link \
  --output "${OUTPUT_DIR}/${TOP}_${PLATFORM}.{% if aie.is_some() %}xsa{% else %}xclbin{% endif %}" \
{% if aie.is_none() %}  --kernel "${TOP}" \
{% endif %}  --platform "${PLATFORM}" \
  --target "${TARGET}" \
  --report_level 2 \
  --temp_dir "${OUTPUT_DIR}/${TOP}_${PLATFORM}.temp" \
  --optimize 3 \
  --connectivity.nk "${TOP}:1:${TOP}" \
  --save-temps \
  "${XO}" \
{% if aie.is_some() %}  "${LIBADF}" \
  --config "${AIE_CFG}" \
{% endif %}  --vivado.synth.jobs "${MAX_SYNTH_JOBS}" \
  --vivado.prop=run.impl_1.STEPS.PHYS_OPT_DESIGN.IS_ENABLED=1 \
  --vivado.prop=run.impl_1.STEPS.OPT_DESIGN.ARGS.DIRECTIVE="${STRATEGY}" \
  --vivado.prop=run.impl_1.STEPS.PLACE_DESIGN.ARGS.DIRECTIVE="${PLACEMENT_STRATEGY}" \
  --vivado.prop=run.impl_1.STEPS.PHYS_OPT_DESIGN.ARGS.DIRECTIVE="${STRATEGY}" \
  --vivado.prop=run.impl_1.STEPS.ROUTE_DESIGN.ARGS.DIRECTIVE="${STRATEGY}" \
{% if let Some(floorplan_xdc) = floorplan_xdc %}  --vivado.prop=run.impl_1.STEPS.OPT_DESIGN.TCL.PRE={{ floorplan_xdc }} \
{% endif %}{% if let Some(connectivity_ini) = connectivity_ini %}  --config {{ connectivity_ini }} \
{% endif %}{% if target_frequency.is_some() %}{% if aie.is_some() %}  --clock.default_freqhz "${TARGET_FREQUENCY}" \
{% else %}  --kernel_frequency "${TARGET_FREQUENCY}" \
{% endif %}{% endif %}
{% if aie.is_some() %}
v++ ${DEBUG} \
  --package \
  --target "${TARGET}" \
  --platform "${PLATFORM}" \
  --save-temps \
  --temp_dir "${OUTPUT_DIR}/${TOP}_${PLATFORM}.package" \
  --output "${OUTPUT_DIR}/${TOP}_${PLATFORM}.xclbin" \
{% if let Some((kernel_image, rootfs, sd_files)) = embedded %}  --package.boot_mode=sd \
  --package.kernel_image={{ kernel_image }} \
  --package.rootfs={{ rootfs }} \
  --package.defer_aie_run \
{% for sd_file in sd_files %}  --package.sd_file={{ sd_file }} \
{% endfor %}{% endif %}  "${OUTPUT_DIR}/${TOP}_${PLATFORM}.xsa" \
  "${LIBADF}"
{% endif %}
