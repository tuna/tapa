"""Build rules for the mdBook documentation."""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//bazel:file_rules.bzl", "mdbook_tar")

# Supported local dev platforms: Linux x86_64, macOS x86_64, macOS arm64.
# Linux arm64 is not supported via Bazel — use the RTD cargo install path instead.

# config_settings for combined OS+CPU constraints used in the select()s below.
config_setting(
    name = "_macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "_macos_amd64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

MDBOOK_BIN = select({
    ":_macos_arm64": "@mdbook_macos_arm64//:mdbook",
    ":_macos_amd64": "@mdbook_macos_amd64//:mdbook",
    "//conditions:default": "@mdbook_linux_amd64//:mdbook",
})

MDBOOK_ADMONISH_BIN = select({
    ":_macos_arm64": "@mdbook_admonish_macos_arm64//:mdbook-admonish",
    ":_macos_amd64": "@mdbook_admonish_macos_amd64//:mdbook-admonish",
    "//conditions:default": "@mdbook_admonish_linux_amd64//:mdbook-admonish",
})

MDBOOK_TOOLS = select({
    ":_macos_arm64": [
        "@mdbook_admonish_macos_arm64//:mdbook-admonish",
        "@mdbook_macos_arm64//:mdbook",
    ],
    ":_macos_amd64": [
        "@mdbook_admonish_macos_amd64//:mdbook-admonish",
        "@mdbook_macos_amd64//:mdbook",
    ],
    "//conditions:default": [
        "@mdbook_admonish_linux_amd64//:mdbook-admonish",
        "@mdbook_linux_amd64//:mdbook",
    ],
})

mdbook_tar(
    name = "build",
    srcs = glob(["src/**"]) + ["book.toml"],
    out = "book.tar.gz",
    book_toml = "book.toml",
    mdbook = MDBOOK_BIN,
    mdbook_admonish = MDBOOK_ADMONISH_BIN,
    tags = ["manual"],
)

sh_binary(
    name = "serve",
    srcs = ["serve.sh"],
    data = MDBOOK_TOOLS + glob(["src/**"]) + ["book.toml"],
    tags = ["manual"],
)
