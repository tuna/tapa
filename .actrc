# Shared act (nektosact) configuration. Host-specific extras (container user,
# HOME, license dir) must be passed on the command line, e.g.:
#   act workflow_dispatch -W .github/workflows/staging-build.yml \
#     --container-options "--user $(id -u):$(getent group docker | cut -d: -f3)"
#
# The host executor (-P self-hosted=-self-hosted) is intentionally NOT used:
# act >=0.2.70 cannot resolve local composite actions (./.github/actions/*)
# with it. The docker executor plus --bind keeps ${{ github.workspace }} valid
# for the sibling `docker run -v` mounts made by run-docker.
--artifact-server-path ./artifacts.out
--rm
--pull=false
--secret-file .ci-secrets
--env DOCKER_BUILDKIT=0
--bind
-P self-hosted=catthehacker/ubuntu:act-latest
-e .actevent.json
