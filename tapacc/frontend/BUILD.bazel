"""Frontend of the rewritten tapacc: AST -> typed program model (no rewrites)."""

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//tapacc:__subpackages__"])

cc_library(
    name = "classify",
    srcs = ["classify.cpp"],
    hdrs = ["classify.h"],
    copts = ["-fno-rtti"],
    deps = ["@tapa-llvm-project//clang:tooling"],
)

cc_library(
    name = "program",
    srcs = ["program.cpp"],
    hdrs = ["program.h"],
    copts = ["-fno-rtti"],
    deps = [
        ":classify",
        "@tapa-llvm-project//clang:tooling",
    ],
)

cc_library(
    name = "type_args",
    srcs = ["type_args.cpp"],
    hdrs = ["type_args.h"],
    copts = ["-fno-rtti"],
    deps = ["@tapa-llvm-project//clang:tooling"],
)

cc_library(
    name = "ports",
    srcs = ["ports.cpp"],
    hdrs = ["ports.h"],
    copts = ["-fno-rtti"],
    deps = [
        ":classify",
        ":program",
        ":type_args",
        "@tapa-llvm-project//clang:tooling",
    ],
)

# Shared TAPA stand-in declarations for frontend unit tests.
cc_library(
    name = "tapa_stub_decls",
    testonly = True,
    hdrs = ["tapa_stub_decls.h"],
)

cc_test(
    name = "type_args_test",
    srcs = ["type_args_test.cpp"],
    copts = ["-fno-rtti"],
    deps = [
        ":tapa_stub_decls",
        ":type_args",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@tapa-llvm-project//clang:tooling",
    ],
)

cc_test(
    name = "ports_test",
    srcs = ["ports_test.cpp"],
    copts = ["-fno-rtti"],
    deps = [
        ":classify",
        ":ports",
        ":tapa_stub_decls",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@tapa-llvm-project//clang:tooling",
    ],
)

cc_library(
    name = "names",
    srcs = ["names.cpp"],
    hdrs = ["names.h"],
    copts = ["-fno-rtti"],
    deps = ["@tapa-llvm-project//clang:tooling"],
)

cc_library(
    name = "discover",
    srcs = ["discover.cpp"],
    hdrs = ["discover.h"],
    copts = ["-fno-rtti"],
    deps = [
        ":classify",
        ":names",
        ":program",
        "@tapa-llvm-project//clang:tooling",
    ],
)

cc_library(
    name = "invoke_parser",
    srcs = ["invoke_parser.cpp"],
    hdrs = ["invoke_parser.h"],
    copts = ["-fno-rtti"],
    deps = [
        ":classify",
        ":discover",
        ":names",
        ":program",
        ":type_args",
        "@tapa-llvm-project//clang:tooling",
    ],
)

cc_test(
    name = "invoke_parser_test",
    srcs = ["invoke_parser_test.cpp"],
    copts = ["-fno-rtti"],
    deps = [
        ":discover",
        ":invoke_parser",
        ":program",
        ":tapa_stub_decls",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@tapa-llvm-project//clang:tooling",
    ],
)

cc_test(
    name = "discover_test",
    srcs = ["discover_test.cpp"],
    copts = ["-fno-rtti"],
    deps = [
        ":discover",
        ":program",
        ":tapa_stub_decls",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@tapa-llvm-project//clang:tooling",
    ],
)

cc_test(
    name = "classify_test",
    srcs = ["classify_test.cpp"],
    copts = ["-fno-rtti"],
    deps = [
        ":classify",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        "@tapa-llvm-project//clang:tooling",
    ],
)
