load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")

cc_binary(
    name = "tapacc",
    srcs = ["tapacc.cpp"],
    copts = ["-fno-rtti"],
    visibility = ["//visibility:public"],
    deps = [
        "//tapacc/rewriter:task",
        "@tapa-llvm-project//clang:tooling",
    ],
)

# The rewritten tapacc (in progress). Dev entry point that emits per-task
# generated code as JSON for old-vs-new diffing; graph serialization is held
# until the tapa-ir schema lands.
cc_binary(
    name = "tapacc_ng",
    srcs = ["tapacc_ng.cpp"],
    copts = ["-fno-rtti"],
    visibility = ["//visibility:public"],
    deps = [
        "//tapacc/codegen:rewrite",
        "//tapacc/codegen:xilinx",
        "//tapacc/frontend:build_program",
        "@nlohmann_json//:json",
        "@tapa-llvm-project//clang:tooling",
    ],
)

pkg_files(
    name = "pkg",
    srcs = [":tapacc"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "usr/bin",
    strip_prefix = strip_prefix.files_only(),
    visibility = ["//visibility:public"],
)
