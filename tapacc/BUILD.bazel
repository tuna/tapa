load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
load("//tapacc:defs.bzl", "CLANG_TOOLING", "TAPACC_COPTS")

cc_binary(
    name = "tapacc",
    srcs = ["tapacc.cpp"],
    copts = TAPACC_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        "//tapacc/codegen:builder_action",
        "//tapacc/codegen:tree_writer",
        "//tapacc/frontend:program_builder",
        "@nlohmann_json//:json",
        CLANG_TOOLING,
    ],
)

pkg_files(
    name = "pkg",
    srcs = [":tapacc"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "usr/bin",
    strip_prefix = strip_prefix.files_only(),
    visibility = ["//visibility:public"],
)
