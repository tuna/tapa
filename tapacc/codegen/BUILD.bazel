"""Codegen of the rewritten tapacc: typed Program (+ AST) -> vendor C++."""

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tapacc:defs.bzl", "CLANG_TOOLING", "TAPACC_COPTS")

package(default_visibility = ["//tapacc:__subpackages__"])

cc_library(
    name = "conventions",
    hdrs = ["conventions.h"],
)

cc_library(
    name = "schema_fields",
    hdrs = ["schema_fields.h"],
)

cc_library(
    name = "code_sink",
    hdrs = ["code_sink.h"],
    deps = ["@tapa-llvm-project//llvm:Support"],
)

cc_library(
    name = "backend",
    hdrs = ["backend.h"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":code_sink",
        ":edit_sink",
        "//tapacc/frontend:classify",
        "//tapacc/frontend:program",
        CLANG_TOOLING,
    ],
)

cc_test(
    name = "conventions_test",
    srcs = ["conventions_test.cpp"],
    data = ["//tapa-core:tapa-ir/testdata/naming_conventions.tsv"],
    env = {
        "TAPA_NAMING_FIXTURE": "$(rlocationpath //tapa-core:tapa-ir/testdata/naming_conventions.tsv)",
    },
    deps = [
        ":code_sink",
        ":conventions",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "macro_splice",
    srcs = ["macro_splice.cpp"],
    hdrs = ["macro_splice.h"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        CLANG_TOOLING,
        "@tapa-llvm-project//clang:tooling_syntax",
        "@tapa-llvm-project//llvm:Support",
    ],
)

cc_test(
    name = "expansion_splice_test",
    srcs = ["expansion_splice_test.cpp"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":macro_splice",
        "//tapacc/frontend:tapa_stub_decls",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        CLANG_TOOLING,
        "@tapa-llvm-project//clang:tooling_syntax",
    ],
)
