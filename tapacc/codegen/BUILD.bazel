"""Codegen of the rewritten tapacc: typed Program (+ AST) -> vendor C++."""

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//tapacc:defs.bzl", "CLANG_TOOLING", "TAPACC_COPTS")

package(default_visibility = ["//tapacc:__subpackages__"])

cc_library(
    name = "conventions",
    hdrs = ["conventions.h"],
)

cc_library(
    name = "schema_fields",
    hdrs = ["schema_fields.h"],
)

cc_library(
    name = "code_sink",
    hdrs = ["code_sink.h"],
    deps = ["@tapa-llvm-project//llvm:Support"],
)

cc_library(
    name = "backend",
    hdrs = ["backend.h"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":code_sink",
        ":edit_sink",
        "//tapacc/frontend:classify",
        "//tapacc/frontend:program",
        CLANG_TOOLING,
    ],
)

cc_test(
    name = "conventions_test",
    srcs = ["conventions_test.cpp"],
    data = ["//tapa-core:tapa-ir/testdata/naming_conventions.tsv"],
    env = {
        "TAPA_NAMING_FIXTURE": "$(rlocationpath //tapa-core:tapa-ir/testdata/naming_conventions.tsv)",
    },
    deps = [
        ":code_sink",
        ":conventions",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "edit_sink",
    srcs = ["edit_sink.cpp"],
    hdrs = ["edit_sink.h"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        "//tapacc/frontend:diag",
        CLANG_TOOLING,
    ],
)

cc_library(
    name = "emit",
    srcs = ["emit.cpp"],
    hdrs = ["emit.h"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":code_sink",
        ":conventions",
        ":edit_sink",
        "//tapacc/frontend:classify",
        "//tapacc/frontend:type_args",
        CLANG_TOOLING,
    ],
)

cc_test(
    name = "emit_test",
    srcs = ["emit_test.cpp"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":code_sink",
        ":emit",
        "//tapacc/frontend:classify",
        "//tapacc/frontend:tapa_stub_decls",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        CLANG_TOOLING,
    ],
)

cc_library(
    name = "xilinx",
    srcs = ["xilinx.cpp"],
    hdrs = ["xilinx.h"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":backend",
        ":conventions",
        ":edit_sink",
        ":emit",
        "//tapacc/frontend:classify",
        "//tapacc/frontend:type_args",
        CLANG_TOOLING,
    ],
)

cc_library(
    name = "ignore",
    srcs = ["ignore.cpp"],
    hdrs = ["ignore.h"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":backend",
        ":code_sink",
        ":edit_sink",
        ":emit",
        "//tapacc/frontend:classify",
        CLANG_TOOLING,
    ],
)

cc_library(
    name = "wrapper",
    srcs = ["wrapper.cpp"],
    hdrs = ["wrapper.h"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":backend",
        ":code_sink",
        ":edit_sink",
        "//tapacc/frontend:classify",
        "//tapacc/frontend:program",
        CLANG_TOOLING,
    ],
)

cc_library(
    name = "rewrite",
    srcs = ["rewrite.cpp"],
    hdrs = ["rewrite.h"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":backend",
        ":conventions",
        ":edit_sink",
        ":emit",
        ":tree_writer",
        ":wrapper",
        "//tapacc/frontend:diag",
        "//tapacc/frontend:discover",
        "//tapacc/frontend:program",
        CLANG_TOOLING,
    ],
)

cc_library(
    name = "tree_writer",
    srcs = ["tree_writer.cpp"],
    hdrs = ["tree_writer.h"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":edit_sink",
        CLANG_TOOLING,
        "@tapa-llvm-project//llvm:Support",
    ],
)

cc_test(
    name = "tree_writer_test",
    srcs = ["tree_writer_test.cpp"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":tree_writer",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        CLANG_TOOLING,
        "@tapa-llvm-project//llvm:Support",
    ],
)

cc_test(
    name = "expansion_splice_test",
    srcs = ["expansion_splice_test.cpp"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        "//tapacc/frontend:tapa_stub_decls",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        CLANG_TOOLING,
        "@tapa-llvm-project//clang:tooling_syntax",
    ],
)

cc_test(
    name = "rewrite_test",
    srcs = ["rewrite_test.cpp"],
    copts = TAPACC_COPTS,
    includes = [".."],
    deps = [
        ":ignore",
        ":rewrite",
        ":tree_writer",
        ":xilinx",
        "//tapacc/frontend:program",
        "//tapacc/frontend:program_builder",
        "//tapacc/frontend:tapa_stub_decls",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
        CLANG_TOOLING,
    ],
)
