load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//bazel:test_rules.bzl", "aie_sim_test", "tapa_app_test")

exports_files(
    [
        ".",
        "cannon-host.cpp",
        "cannon.cpp",
        "cannon.h",
    ],
    visibility = [
        "//tests/apps:__pkg__",
        "//tests/functional:__subpackages__",
    ],
)

tapa_app_test(
    name = "cannon",
    host_srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    hw_test_timeout = "long",  # often >300s
    top_name = "Cannon",
)

# A block row of eight-lane vectors needs a 32-float edge for four vectors.
cc_binary(
    name = "cannon-aie-host",
    srcs = [
        "cannon.cpp",
        "cannon.h",
        "cannon-host.cpp",
    ],
    local_defines = ["TAPA_CANNON_B=32"],
    tags = ["manual"],
    deps = [
        "//tapa-lib:tapa-host",
        "@gflags",
    ],
)

# The PEs on the AI Engine, on x86sim, the PL tasks in software.
# Developer-run (needs Vitis with aiecompiler): not part of `bazel test //...`.
aie_sim_test(
    name = "cannon-aie-x86sim",
    compile_flags = [
        "--target=ProcElem:aie",
        "--cflags=-DTAPA_CANNON_B=32",
        "--cflags=-DTAPA_CANNON_LANES=8",
    ],
    host = ":cannon-aie-host",
    kernel = "cannon",
    top_name = "Cannon",
)
