load("//bazel:test_rules.bzl", "tapa_app_test")

exports_files(
    [
        ".",
        "cannon-host.cpp",
        "cannon.cpp",
        "cannon.h",
    ],
    visibility = [
        "//tests/apps:__pkg__",
        "//tests/functional:__subpackages__",
