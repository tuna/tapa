"""The multi-file test app: the spec for the multi-file frontend campaign.

The kernel tier spans two translation units; a.cpp owns the top, Produce,
and the ScaleValue helper, b.cpp owns Consume, and the shared header
defines the Combine<float> template task. helper.h is reached via -I from
tests/apps/multi-file-ext, one directory outside this package.
"""

load("//bazel:test_rules.bzl", "tapa_app_test")
load("//bazel:test_tool_rules.bzl", "test_tool_test")

exports_files(
    [
        ".",
        "a.cpp",
        "b.cpp",
        "multi-file-host.cpp",
        "multi-file.h",
        "testdata/capabilities.json",
    ],
    visibility = [
        # Mirrors tests/apps/vadd: later milestones' frontend rules and the
        # tapa-core conformance test analyze these kernel sources.
        "//tapa-core:__pkg__",
        "//tests/apps:__pkg__",
        "//tests/functional:__subpackages__",
    ],
)

tapa_app_test(
    name = "multi-file",
    host_deps = ["//tests/apps/multi-file-ext:helper"],
    host_srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    hw_test_args = ["1000"],
    # helper.h rides in hdrs (not just includes) so the sandbox stages the
    # multi-file-ext dir the -I flag points into; the include label only
    # names the path, it does not stage files.
    kernel_hdrs = [
        "multi-file.h",
        "//tests/apps/multi-file-ext:helper.h",
    ],
    kernel_includes = [
        ".",
        "//tests/apps/multi-file-ext:.",
    ],
    kernel_srcs = [
        "a.cpp",
        "b.cpp",
    ],
    macos_sim_args = ["1000"],
    top_name = "MultiFileTop",
)

# The MF0 capability tripwire: runs `mf-capabilities` (tools/test-tools),
# which compares the current pipeline's behavior on this app against
# testdata/capabilities.json. Passes only while reality matches the
# manifest; a capability that gets fixed must flip its entry here.
test_tool_test(
    name = "multi_file_capabilities",
    size = "large",
    command = "mf-capabilities",
    data = [
        "//tapa-core:tapa",
        "//tapa-lib:include",
        # the multi-file app under test
        "a.cpp",
        "b.cpp",
        "multi-file.h",
        "testdata/capabilities.json",
        # out-of-root header reached via -I
        "//tests/apps/multi-file-ext:helper.h",
        # positive-control probe (sanity_vadd_analyze)
        "//tests/apps/vadd:vadd.cpp",
        "//tests/apps/vadd:vadd.h",
    ],
)
