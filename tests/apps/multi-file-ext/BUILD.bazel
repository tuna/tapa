"""Out-of-root helper header for the multi-file app."""

load("@rules_cc//cc:defs.bzl", "cc_library")

exports_files(
    [
        # "." is the include dir the multi-file kernel's tapa_xo passes as
        # --cflags -I; exporting it also stages the dir for the sandbox.
        ".",
        "helper.h",
    ],
    visibility = [
        "//tapa-core:__pkg__",
        "//tests/apps:__pkg__",
        "//tests/apps:__subpackages__",
        "//tests/functional:__subpackages__",
    ],
)

cc_library(
    name = "helper",
    hdrs = ["helper.h"],
    includes = ["."],
    visibility = ["//tests/apps:__subpackages__"],
)
