"""Out-of-root helper header for the multi-file app."""

load("@rules_cc//cc:defs.bzl", "cc_library")

exports_files(
    ["helper.h"],
    visibility = [
        "//tapa-core:__pkg__",
        "//tests/apps:__pkg__",
        "//tests/apps:__subpackages__",
        "//tests/functional:__subpackages__",
    ],
)

cc_library(
    name = "helper",
    hdrs = ["helper.h"],
    includes = ["."],
    visibility = ["//tests/apps:__subpackages__"],
)
