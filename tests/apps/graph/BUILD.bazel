load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:file_rules.bzl", "facebook_txt")
load("//bazel:test_rules.bzl", "tapa_app_test")

exports_files(
    [
        ".",
        "graph.cpp",
        "graph.h",
        "nxgraph.hpp",
        "graph.txt",
    ],
    visibility = [
        "//tests/apps:__pkg__",
        "//tests/functional:__subpackages__",
    ],
)

tapa_app_test(
    name = "graph",
    extra_test_data = ["graph.txt"],
    host_srcs = glob([
        "*.cpp",
        "*.h",
        "*.hpp",
    ]),
    hw_test_args = ["$(location graph.txt)"],
    kernel_hdrs = glob([
        "*.hpp",
        "*.h",
    ]),
    sim_args = ["$(location graph.txt)"],
    top_name = "Graph",
)

sh_test(
    name = "graph-facebook",
    size = "medium",
    srcs = select({
        "//bazel:is_macos": ["//bazel:sim_env.sh"],
        "//conditions:default": ["//bazel:v++_env.sh"],
    }),
    args = [
        "$(location graph-host)",
        "$(location process_facebook_txt)",
        "512",
    ],
    data = [
        ":graph-host",
        ":process_facebook_txt",
    ],
    env = {"TAPA_CONCURRENCY": "1"},
)

facebook_txt(
    name = "process_facebook_txt",
    src = "@facebook_combined//file:facebook.txt.gz",
    out = "facebook.txt",
)
