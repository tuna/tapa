load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:test_rules.bzl", "tapa_app_test")

exports_files(
    [
        ".",
        "vadd-host.cpp",
        "vadd.cpp",
        "vadd.h",
    ],
    visibility = [
        # `//tapa-core:tapacc_conformance_test` analyzes this kernel with the
        # real tapacc to check its output against the tapa-ir schema.
        "//tapa-core:__pkg__",
        "//tests/apps:__pkg__",
        "//tests/functional:__subpackages__",
    ],
)

tapa_app_test(
    name = "vadd",
    host_srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    hw_test_args = ["1000"],
    macos_sim_args = ["1000"],
    top_name = "VecAdd",
    xo_visibility = ["//tests/functional:__subpackages__"],
)

sh_test(
    name = "vadd-zipsim",
    size = "enormous",
    timeout = "moderate",
    srcs = ["//bazel:xrt_env.sh"],
    args = [
        "$(location vadd-host)",
        "--bitstream=$(location vadd-zip)",
        "1000",
    ],
    data = [
        ":vadd-host",
        ":vadd-zip",
        "//fpga-runtime:cargo_release_artifacts",
    ],
    tags = ["cpu:2"],
)
