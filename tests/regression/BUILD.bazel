"""Nightly regression tier: real-world designs compiled to .xo.

Each target mirrors the parameters of the design's checked-in
`run_tapa.sh`. Everything here is `manual`: the builds need Vitis HLS
and real wall time, so only the nightly workflow builds them, through
the `:nightly` aggregation target. Designs without a `run_tapa.sh`
(and thus without declared parameters) are not in the tier yet.
"""

load("//bazel:tapa_rules.bzl", "tapa_xo")

tapa_xo(
    name = "callipepla-xo",
    src = "callipepla/tapa/src_noconst/callipepla.cpp",
    hdrs = ["callipepla/tapa/src_noconst/callipepla.h"],
    clock_period = "3.33",
    jobs = 8,
    part_num = "xcu55c-fsvh2892-2L-e",
    tags = [
        "cpu:8",
        "manual",
    ],
    top_name = "Callipepla",
)

tapa_xo(
    name = "serpens-24ch-xo",
    src = "serpens-24ch/tapa/src/serpens-noconst.cpp",
    hdrs = [
        "serpens-24ch/tapa/src/mmio.h",
        "serpens-24ch/tapa/src/serpens-noconst.h",
        "serpens-24ch/tapa/src/sparse_helper.h",
    ],
    clock_period = "3.33",
    connectivity = "serpens-24ch/tapa/src/link_config.ini",
    jobs = 8,
    part_num = "xcu55c-fsvh2892-2L-e",
    tags = [
        "cpu:8",
