"""Full-scale regression designs compiled to .xo.

Each `tapa_xo` selects the canonical source variant and validated target
parameters for one design. XO and xsim targets are `manual`: they need vendor
tools and substantial wall time. The `:nightly` filegroup aggregates every
canonical XO. A design with a `tapa::invoke` host also exposes a manual
`<name>-xosim` target. OpenCL-only hosts cannot directly drive TAPA fast
cosimulation.
"""

load("@rules_cc//cc:defs.bzl", "cc_test")
load("//bazel:tapa_rules.bzl", "tapa_xo")
load("//bazel:test_rules.bzl", "regression_xosim")

