load("//bazel:tapa_rules.bzl", "tapa_xo")
load("//bazel:test_tool_rules.bzl", "test_tool_test")

tapa_xo(
    name = "enable-synth-util-xo",
    src = "vadd.cpp",
    clock_period = "3.333",  # for #258
    enable_synth_util = True,
    output_file = "enable-synth-util.xo",
    part_num = "xcv80-lsva4737-2MHP-e-S",  # for #258
    top_name = "VecAdd",
)

test_tool_test(
    name = "report-test",
    command = "check-xo-reports",
    data = [
        ":enable-synth-util-xo",
    ],
    data_args = [":enable-synth-util-xo"],
)
