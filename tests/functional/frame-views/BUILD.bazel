"""Frame ports: corner turns through frame channels."""

load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@vars//:vars.bzl", "HAS_XRT", "XILINX_HW_EMU_PLATFORM")
load("//bazel:tapa_rules.bzl", "tapa_xo")
load("//bazel:test_rules.bzl", "aie_sim_test", "tapa_functional_test")
load("//bazel:v++_rules.bzl", "vpp_xclbin")

tapa_functional_test(
    name = "frame-views",
    host_srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    kernel_hdrs = ["corner.h"],
    kernel_srcs = ["corner.cpp"],
    top_name = "CornerTurn",
)

# The turns on the AI Engine, on x86sim: a PLIO into a frame port's buffers,
# two AI Engine frame ports joined directly, a frame port and a stream port
# in one kernel, and a frame port's buffers out to a PLIO.
aie_sim_test(
    name = "frame-views-x86sim",
    compile_flags = [
        "--target=Turn:aie",
        "--target=TurnOut:aie",
        "--target=TurnIn:aie",
    ],
    host = ":frame-views-host",
    kernel = "corner",
    top_name = "CornerTurn",
)

# Cycle-approximate: chess compiles the turns, and aiesimulator replays the
# PLIO streams of a software run and checks the output against it.
aie_sim_test(
    name = "frame-views-aiesim",
    size = "enormous",
    compile_flags = [
        "--target=Turn:aie",
        "--target=TurnOut:aie",
        "--target=TurnIn:aie",
    ],
    host = ":frame-views-host",
    kernel = "corner",
    simulator = "aiesim",
    top_name = "CornerTurn",
)

# TurnStream: frame channels on the top's own stream arguments.
tapa_xo(
    name = "frame-views-stream-xo",
    srcs = ["corner.cpp"],
    hdrs = ["corner.h"],
    top_name = "TurnStream",
)

sh_test(
    name = "frame-views-stream-xosim",
    size = "enormous",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath frame-views-host)",
        "--bitstream=$(rootpath frame-views-stream-xo)",
        "--stream_top",
        "8",
    ],
    data = [
        ":frame-views-host",
        ":frame-views-stream-xo",
        "//fpga-runtime:cargo_release_artifacts",
    ],
    tags = ["cpu:2"],
)

# TurnElemStream: the top's stream arguments reach `[[tapa::frame(N)]]`
# stream ports, so each ring moves its frames through an ordinary FIFO.
tapa_xo(
    name = "frame-views-elem-xo",
    srcs = ["corner.cpp"],
    hdrs = ["corner.h"],
    top_name = "TurnElemStream",
)

sh_test(
    name = "frame-views-elem-xosim",
    size = "enormous",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath frame-views-host)",
        "--bitstream=$(rootpath frame-views-elem-xo)",
        "--elem_top",
        "8",
    ],
    data = [
        ":frame-views-elem-xo",
        ":frame-views-host",
        "//fpga-runtime:cargo_release_artifacts",
    ],
    tags = ["cpu:2"],
)

# TurnStream on XRT hardware emulation: its arguments are rings in device
# memory, which the host fills and drains while the kernel runs. Manual:
# hw_emu's scheduler polls the kernel under the device lock the host's
# register reads and syncs take, so a run lasts from minutes to over an hour.
vpp_xclbin(
    name = "frame-views-stream-hw-emu-xclbin",
    platform_name = XILINX_HW_EMU_PLATFORM,
    tags = ["manual"],
    target = "hw_emu",
    target_compatible_with = [] if HAS_XRT else ["@platforms//:incompatible"],
    top_name = "TurnStream",
    xo = ":frame-views-stream-xo",
)

sh_test(
    name = "frame-views-stream-hw-emu",
    size = "enormous",
    srcs = ["//bazel:xrt_env.sh"],
    args = [
        "$(rootpath frame-views-host)",
        "--bitstream=$(rootpath frame-views-stream-hw-emu-xclbin)",
        "--stream_top",
        "8",
    ],
    data = [
        ":frame-views-host",
        ":frame-views-stream-hw-emu-xclbin",
    ],
    tags = [
        "cpu:2",
        "manual",
    ],
    target_compatible_with = [] if HAS_XRT else ["@platforms//:incompatible"],
)

# Only Turn on the AI Engine: TurnOut's frame port, inside Emit, takes its
# frames from a PLIO through a frame channel in the PL kernel's top.
aie_sim_test(
    name = "frame-views-plio-x86sim",
    compile_flags = ["--target=Turn:aie"],
    host = ":frame-views-host",
    kernel = "corner",
    top_name = "CornerTurn",
)

sh_test(
    name = "frame-views-plio-hybrid",
    size = "enormous",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath //tests/functional/aie-vadd:run_hybrid.sh)",
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :frame-views-host)",
        "$(rootpath corner.cpp)",
        "xilinx_vck190_base_202520_1",
        "CornerTurn",
        "--target=Turn:aie",
    ],
    data = [
        "corner.cpp",
        "corner.h",
        ":frame-views-host",
        "//fpga-runtime:cargo_release_artifacts",
        "//tapa-core:tapa",
        "//tests/functional/aie-vadd:run_hybrid.sh",
    ],
    tags = ["manual"],
)
