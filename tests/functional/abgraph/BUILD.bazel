load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:tapa_rules.bzl", "tapa_xo")

# vadd test
tapa_xo(
    name = "vadd-abgraph-json",
    src = "//tests/apps/vadd:vadd.cpp",
    hdrs = ["//tests/apps/vadd:vadd.h"],
    include = ["."],
    enable_synth_util = True,
    flatten_hierarchy = True,
    floorplan_config = ":test_fp_config.json",
    gen_ab_graph = True,
    top_name = "VecAdd",
)

sh_test(
    name = "vadd-abgraph-test",
    srcs = ["abgraph_test.sh"],
    args = [
        "$(location //tools:test_tools)",
        "vadd",
    ],
    data = [
        "golden/vadd.json",
        ":vadd-abgraph-json",
        "//tools:test_tools",
    ],
)

