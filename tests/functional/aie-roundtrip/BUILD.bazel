"""PL to AIE to PL to AIE to PL round trip."""

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

cc_binary(
    name = "aie-roundtrip-host",
    srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    deps = [
        "//tapa-lib:tapa-host",
        "@gflags",
    ],
)

sh_test(
    name = "aie-roundtrip",
    size = "small",
    srcs = ["//bazel:sim_env.sh"],
    args = ["$(rootpath :aie-roundtrip-host)"],
    data = [":aie-roundtrip-host"],
)

# The AI Engine graph on x86sim, replaying the software-simulation streams.
# Developer-run (needs Vitis with aiecompiler): not part of `bazel test //...`.
sh_test(
    name = "aie-roundtrip-x86sim",
    size = "medium",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath //bazel:run_aiesim.sh)",
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-roundtrip-host)",
        "$(rootpath roundtrip.cpp)",
        "RoundTrip",
        "--",
        "--arg=n=64",
        "--part-num=xcvc1902-vsva2197-2MP-e-S",
    ],
    data = [
        "roundtrip.cpp",
        "roundtrip.h",
        ":aie-roundtrip-host",
        "//bazel:run_aiesim.sh",
        "//tapa-core:tapa",
    ],
    tags = ["manual"],
)

# Hybrid cosimulation: both PL stages in xsim, both AIE stages in software.
sh_test(
    name = "aie-roundtrip-hybrid",
    size = "enormous",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath //tests/functional/aie-vadd:run_hybrid.sh)",
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-roundtrip-host)",
        "$(rootpath roundtrip.cpp)",
        "xilinx_vck190_base_202520_1",
        "RoundTrip",
    ],
    data = [
        "roundtrip.cpp",
        "roundtrip.h",
        ":aie-roundtrip-host",
        "//fpga-runtime:cargo_release_artifacts",
        "//tapa-core:tapa",
        "//tests/functional/aie-vadd:run_hybrid.sh",
    ],
    tags = ["manual"],
)

# Cycle-accurate AI Engine simulation of the same two-kernel graph.
sh_test(
    name = "aie-roundtrip-aiesim",
    size = "enormous",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath //bazel:run_aiesim.sh)",
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-roundtrip-host)",
        "$(rootpath roundtrip.cpp)",
        "RoundTrip",
        "--",
        "--arg=n=64",
        "--part-num=xcvc1902-vsva2197-2MP-e-S",
        "--cycle-accurate",
    ],
    data = [
        "roundtrip.cpp",
        "roundtrip.h",
        ":aie-roundtrip-host",
        "//bazel:run_aiesim.sh",
        "//tapa-core:tapa",
    ],
    tags = ["manual"],
)

# Physical VCK5000 with PL graph control and two complete invocations.
sh_test(
    name = "aie-roundtrip-vck5000-hw",
    size = "enormous",
    srcs = ["//tests/functional/aie-vadd:run_vck5000.sh"],
    args = [
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-roundtrip-host)",
        "$(rootpath roundtrip.cpp)",
        "xilinx_vck5000_gen4x8_qdma_2_202220_1",
        "c1:00.1",
        "RoundTrip",
    ],
    data = [
        "roundtrip.cpp",
        "roundtrip.h",
        ":aie-roundtrip-host",
        "//fpga-runtime:cargo_release_artifacts",
        "//tapa-core:tapa",
    ],
    tags = ["manual"],
)
