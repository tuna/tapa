"""Vector add with one task on the AI Engine."""

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:aie_test.bzl", "aie_vck190_test")

cc_binary(
    name = "aie-vadd-host",
    srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    deps = [
        "//tapa-lib:tapa-host",
        "@gflags",
    ],
)

# Software simulation: the AI Engine task runs as an ordinary task.
sh_test(
    name = "aie-vadd",
    size = "small",
    srcs = ["//bazel:sim_env.sh"],
    args = ["$(rootpath :aie-vadd-host)"],
    data = [":aie-vadd-host"],
)

# The AI Engine graph on x86sim, replaying the software-simulation streams.
# Developer-run (needs Vitis with aiecompiler): not part of `bazel test //...`.
sh_test(
    name = "aie-vadd-x86sim",
    size = "medium",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath //bazel:run_aiesim.sh)",
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-vadd-host)",
        "$(rootpath vadd.cpp)",
        "VecAdd",
        "--",
        "--arg=n=1024",
        "--part-num=xcvc1902-vsva2197-2MP-e-S",
    ],
    data = [
        "vadd.cpp",
        "vadd.h",
        ":aie-vadd-host",
        "//bazel:run_aiesim.sh",
        "//tapa-core:tapa",
    ],
    tags = ["manual"],
)

# Partial-frame padding: 1024 elements do not fill the last 3-element frame.
# The same host and analysis shape as above, with frame ports on every AIE
# boundary. Developer-run (needs Vitis with aiecompiler).
sh_test(
    name = "aie-frame-x86sim",
    size = "medium",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath //bazel:run_aiesim.sh)",
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-vadd-host)",
        "$(rootpath vadd.cpp)",
        "VecAdd",
        "--cflags=-DTAPA_AIE_TEST_FRAME_SIZE=3",
        "--",
        "--arg=n=1024",
        "--part-num=xcvc1902-vsva2197-2MP-e-S",
    ],
    data = [
        "vadd.cpp",
        "vadd.h",
        ":aie-vadd-host",
        "//bazel:run_aiesim.sh",
        "//tapa-core:tapa",
    ],
    tags = ["manual"],
)

# Hybrid cosimulation: the PL kernel in xsim, `Add` in software, the same
# host binary. Developer-run (needs Vitis and the VCK190 base platform).
sh_test(
    name = "aie-vadd-hybrid",
    size = "enormous",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath run_hybrid.sh)",
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-vadd-host)",
        "$(rootpath vadd.cpp)",
        "xilinx_vck190_base_202520_1",
    ],
    data = [
        "run_hybrid.sh",
        "vadd.cpp",
        "vadd.h",
        ":aie-vadd-host",
        "//fpga-runtime:cargo_release_artifacts",
        "//tapa-core:tapa",
    ],
    tags = ["manual"],
)

# Full VCK190 system emulation, including the aarch64 XRT host and graph.
# Run with --config=vck190 and VERSAL_COMMON set to the extracted common image.
aie_vck190_test(
    name = "aie-vadd-hw-emu",
    size = "enormous",
    exec_compatible_with = ["@platforms//cpu:x86_64"],
    headers = ["vadd.h"],
    host = ":aie-vadd-host",
    kernel = "vadd.cpp",
    platform = "xilinx_vck190_base_202520_1",
    tags = ["manual"],
)
