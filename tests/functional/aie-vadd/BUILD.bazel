"""Vector add with one task on the AI Engine."""

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:test_rules.bzl", "aiesim_test")

exports_files(
    [
        "run_hybrid.sh",
        "run_vck5000.sh",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "aie-vadd-host",
    srcs = glob(
        [
            "*.cpp",
            "*.h",
        ],
    ),
    deps = [
        "//tapa-lib:tapa-host",
        "@gflags",
    ],
)

cc_binary(
    name = "aie-detach-host",
    srcs = glob(
        [
            "*.cpp",
            "*.h",
        ],
    ),
    copts = ["-DTAPA_AIE_TEST_REPEATS=2"],
    deps = [
        "//tapa-lib:tapa-host",
        "@gflags",
    ],
)

# Software simulation: the AI Engine task runs as an ordinary task.
sh_test(
    name = "aie-vadd",
    size = "small",
    srcs = ["//bazel:sim_env.sh"],
    args = ["$(rootpath :aie-vadd-host)"],
    data = [":aie-vadd-host"],
)

# The AI Engine graph on x86sim, replaying the software-simulation streams.
aiesim_test(
    name = "aie-vadd-x86sim",
    host = ":aie-vadd-host",
    kernel = "vadd",
    n = 1024,
    top_name = "VecAdd",
)

# Partial-frame padding: 1024 elements do not fill the last 3-element frame.
# The same host and analysis shape as above, with frame ports on every AIE
# boundary.
aiesim_test(
    name = "aie-frame-x86sim",
    analyze_flags = ["--cflags=-DTAPA_AIE_TEST_FRAME_SIZE=3"],
    host = ":aie-vadd-host",
    kernel = "vadd",
    n = 1024,
    top_name = "VecAdd",
)

# Hybrid cosimulation: the PL kernel in xsim, `Add` in software, the same
# host binary. Developer-run (needs Vitis and the VCK190 base platform).
sh_test(
    name = "aie-vadd-hybrid",
    size = "enormous",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath run_hybrid.sh)",
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-vadd-host)",
        "$(rootpath vadd.cpp)",
        "xilinx_vck190_base_202520_1",
    ],
    data = [
        "run_hybrid.sh",
        "vadd.cpp",
        "vadd.h",
        ":aie-vadd-host",
        "//fpga-runtime:cargo_release_artifacts",
        "//tapa-core:tapa",
    ],
    tags = ["manual"],
)

# VCK5000 hardware with PL graph control and two bounded invocations.
# Developer-run on an allocated card with Vitis 2022.2.
sh_test(
    name = "aie-vadd-vck5000-hw",
    size = "enormous",
    srcs = ["run_vck5000.sh"],
    args = [
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-detach-host)",
        "$(rootpath vadd.cpp)",
        "xilinx_vck5000_gen4x8_qdma_2_202220_1",
        "c1:00.1",
    ],
    data = [
        "run_vck5000.sh",
        "vadd.cpp",
        "vadd.h",
        ":aie-detach-host",
        "//fpga-runtime:cargo_release_artifacts",
        "//tapa-core:tapa",
    ],
    tags = ["manual"],
)
