load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:tapa_rules.bzl", "tapa_xo")

sh_test(
    name = "cannon",
    size = "medium",
    srcs = select({
        "//bazel:is_macos": ["//bazel:sim_env.sh"],
        "//conditions:default": ["//bazel:v++_env.sh"],
    }),
    args = ["$(rootpath cannon-host)"] + select({
        "//bazel:is_macos": ["1000"],
        "//conditions:default": [],
    }),
    data = [":cannon-host"],
    env = {"TAPA_CONCURRENCY": "2"},
    tags = ["cpu:2"],
)

sh_test(
    name = "cannon-xosim",
    size = "enormous",
    timeout = "long",  # 85s without contention
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath cannon-host)",
        "--scatter_bitstream=$(rootpath scatter)",
        "--proc_elem_bitstream=$(rootpath proc-elem)",
        "--gather_bitstream=$(rootpath gather)",
    ],
    data = [
        ":cannon-host",
        ":gather",
        ":proc-elem",
        ":scatter",
        "//fpga-runtime:cargo_release_artifacts",
    ],
    env = {"TAPA_CONCURRENCY": "1"},
    tags = ["cpu:8"],
)

[
    cc_binary(
        name = "cannon-host" + suffix,
        srcs = [
            "cannon.cpp",
            "cannon.h",
            "//tests/apps/cannon:cannon-host.cpp",
        ],
        defines = ["TAPA_CANNON_P=%d" % p],
        includes = ["."],
        tags = tags,
        deps = [
            "//tapa-lib:tapa-host",
            "@gflags",
        ],
    )
    for p, suffix, tags in [
        (2, "", []),
        (
            4,
            "-4x4",
            ["manual"],
        ),
    ]
]

[
    tapa_xo(
        name = task_name + suffix,
        srcs = ["cannon.cpp"],
        hdrs = ["cannon.h"],
        include = ["."],
        cflags = "-DTAPA_CANNON_P=%d" % p,
        tags = tags,
        target = "xilinx-hls",
        top_name = top_name,
    )
    for p, suffix, tags in [
        (2, "", []),
        (
            4,
            "-4x4",
            ["manual"],
        ),
    ]
    for task_name, top_name in [
        ("scatter", "Scatter"),
        ("proc-elem", "ProcElem"),
        ("gather", "Gather"),
    ]
]

sh_test(
    name = "cannon-4x4",
    size = "medium",
    srcs = select({
        "//bazel:is_macos": ["//bazel:sim_env.sh"],
        "//conditions:default": ["//bazel:v++_env.sh"],
    }),
    args = ["$(rootpath cannon-host-4x4)"] + select({
        "//bazel:is_macos": ["1000"],
        "//conditions:default": [],
    }),
    data = [":cannon-host-4x4"],
    env = {"TAPA_CONCURRENCY": "1"},
)

sh_test(
    name = "cannon-xosim-4x4",
    size = "enormous",
    timeout = "long",  # 125s without contention
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath cannon-host-4x4)",
        "--scatter_bitstream=$(rootpath scatter-4x4)",
        "--proc_elem_bitstream=$(rootpath proc-elem-4x4)",
        "--gather_bitstream=$(rootpath gather-4x4)",
    ],
    data = [
        ":cannon-host-4x4",
        ":gather-4x4",
        ":proc-elem-4x4",
        ":scatter-4x4",
        "//fpga-runtime:cargo_release_artifacts",
    ],
    env = {"TAPA_CONCURRENCY": "1"},
    tags = [
        "cpu:20",
        "manual",
    ],
)
