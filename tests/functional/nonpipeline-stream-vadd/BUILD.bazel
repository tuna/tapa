load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:tapa_rules.bzl", "tapa_xo")

sh_test(
    name = "nonpipeline-stream-vadd",
    size = "medium",
    srcs = ["//bazel:v++_env.sh"],
    args = ["$(rootpath //tests/apps/vadd:vadd-host)"],
    data = ["//tests/apps/vadd:vadd-host"],
    env = {"TAPA_CONCURRENCY": "2"},
    tags = ["cpu:2"],
)

sh_test(
    name = "nonpipeline-stream-vadd-xosim",
    size = "enormous",
    timeout = "moderate",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath //tests/apps/vadd:vadd-host)",
        "--bitstream=$(rootpath nonpipeline-stream-vadd-xo)",
        "1000",
    ],
    data = [
        ":nonpipeline-stream-vadd-xo",
        "//fpga-runtime:cargo_release_artifacts",
        "//tests/apps/vadd:vadd-host",
    ],
    tags = [
        "cpu:2",
    ],
)

tapa_xo(
    name = "nonpipeline-stream-vadd-xo",
    srcs = ["vadd.cpp"],
    hdrs = ["vadd.h"],
    include = ["."],
    top_name = "VecAdd",
)
