"""An AI Engine top with no PL task: frames over GMIO."""

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:aie_test.bzl", "aie_vck190_test")
load("//bazel:test_rules.bzl", "aie_sim_test")

cc_binary(
    name = "aie-gmio-host",
    srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    deps = [
        "//tapa-lib:tapa-host",
        "@gflags",
    ],
)

sh_test(
    name = "aie-gmio",
    size = "small",
    srcs = ["//bazel:sim_env.sh"],
    args = ["$(rootpath :aie-gmio-host)"],
    data = [":aie-gmio-host"],
)

# The whole graph on x86sim, fed and drained live by the host.
aie_sim_test(
    name = "aie-gmio-x86sim",
    host = ":aie-gmio-host",
    kernel = "gmio",
    top_name = "Pipeline",
)

# The whole graph on aiesim, replaying a software run.
aie_sim_test(
    name = "aie-gmio-aiesim",
    size = "enormous",
    host = ":aie-gmio-host",
    kernel = "gmio",
    simulator = "aiesim",
    top_name = "Pipeline",
)

# VCK5000 hybrid cosimulation: the PL kernel TAPA builds for the top, whose
# frame arguments move through rings in device memory to PLIOs, in xsim,
# against the AI Engine tasks in software, which send each output's frame
# count when they return.
sh_test(
    name = "aie-gmio-vck5000-hybrid",
    size = "enormous",
    srcs = ["//bazel:v++_env.sh"],
    args = [
        "$(rootpath //tests/functional/aie-vadd:run_hybrid.sh)",
        "$(rootpath //tapa-core:tapa)",
        "$(rootpath :aie-gmio-host)",
        "$(rootpath gmio.cpp)",
        "xilinx_vck5000_gen4x8_qdma_2_202220_1",
        "Pipeline",
    ],
    data = [
        "gmio.cpp",
        "gmio.h",
        ":aie-gmio-host",
        "//fpga-runtime:cargo_release_artifacts",
        "//tapa-core:tapa",
        "//tests/functional/aie-vadd:run_hybrid.sh",
    ],
    # The host keeps a run's frames in its streams: at most 16.
    env = {"HYBRID_HOST_ARG": "6"},
)

# VCK190 system emulation: the graph in QEMU's AI Engine model, driven by
# the aarch64 host through XRT's graph API and GMIO. Run with
# --test_env=VERSAL_COMMON=<extracted xilinx-versal-common directory>.
aie_vck190_test(
    name = "aie-gmio-hw-emu",
    size = "enormous",
    exec_compatible_with = ["@platforms//cpu:x86_64"],
    headers = ["gmio.h"],
    host = ":aie-gmio-host",
    kernel = "gmio.cpp",
    platform = "xilinx_vck190_base_202520_1",
    tags = ["manual"],
    top = "Pipeline",
)
