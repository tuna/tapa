load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:test_rules.bzl", "aiesim_test")

cc_binary(
    name = "aie-elements-host",
    srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    deps = [
        "//tapa-lib:tapa-host",
        "@gflags",
    ],
)

sh_test(
    name = "aie-elements",
    size = "small",
    srcs = ["//bazel:sim_env.sh"],
    args = ["$(rootpath :aie-elements-host)"],
    data = [":aie-elements-host"],
)

# Whole-word generic and non-native vector element I/O.
aiesim_test(
    name = "aie-elements-x86sim",
    host = ":aie-elements-host",
    kernel = "element",
    n = 5,
    top_name = "Elements",
)
